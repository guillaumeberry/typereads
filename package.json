{
  "name": "typereads",
  "version": "0.0.1",
  "private": true,
  "description": "A curated, open-source library of publications about type design.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "astro build && wrangler deploy",
    "test": "vitest run",
    "fonts": "node scripts/fonts.mjs",
    "predev": "node scripts/fonts.mjs",
    "prebuild": "node scripts/fonts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/archivo-narrow": "5.3.0",
    "@swup/head-plugin": "2.3.1",
    "@swup/js-plugin": "3.2.0",
    "@swup/preload-plugin": "3.2.12",
    "@swup/scroll-plugin": "4.0.0",
    "astro": "7.4.12",
    "gsap": "3.15.1",
    "swup": "4.10.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
