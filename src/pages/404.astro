---
// 404 (Figma "404 desktop", ADR-013): "404" spelled in a 12 × 6 matrix of dots on a
// white card, then "I'm feeling curious (and lucky)" (a random publication, picked by
// src/scripts/notdef.ts; without JS it links to the first one) and a way back home.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getPublished } from '../lib/publications';

const slugs = (await getPublished()).map((p) => p.data.slug);
const fallback = slugs[0] ?? '';

// The matrix, row by row: # is a black dot, . a grey one ("4", gap, "0", gap, "4").
const MATRIX = [
  '#.#..##..#.#',
  '#.#.#..#.#.#',
  '#.#.#..#.#.#',
  '###.#..#.###',
  '..#.#..#...#',
  '..#..##....#',
];
const dots = MATRIX.flatMap((row, r) => [...row].map((c, col) => ({ on: c === '#', r, col })));
---

<Base title="Page not found" noindex>
  <a class="trigger t-caption home" href="/" slot="header-back">
    Home
    <Icon name="back" />
  </a>

  <div class="wrap page" data-notdef data-slugs={JSON.stringify(slugs)}>
    <div class="card">
      <h1 class="visually-hidden">Page not found (404)</h1>
      <div class="matrix" aria-hidden="true">
        {dots.map((d) => (
          <span class:list={['dot', { on: d.on }]} style={`--d:${d.col + d.r}`} />
        ))}
      </div>
    </div>
    <p class="actions">
      <a class="btn-primary t-paragraph" href={`/publications/${fallback}`} data-random>
        I’m feeling curious (and lucky)
        <span class="btn-icon" aria-hidden="true">
          <Icon name="next" class="out" />
          <Icon name="next" class="in" />
        </span>
      </a>
      <a class="u-link t-paragraph" href="/">
        Nah, bring me back home
      </a>
    </p>
  </div>
</Base>

<style>
  .home {
    min-width: 108px;
  }
  .page {
    padding-top: var(--x3l);
  }
  /* Figma: a white card, 96px above and below the matrix, the matrix 1372px wide. */
  .card {
    padding: 96px var(--l);
    background: var(--surface);
    border-radius: var(--radius-l);
  }
  .matrix {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(6px, 1.25vw, 20px); /* Figma: 96px dots, 20px apart at 1600px */
    max-width: 1372px;
    margin-inline: auto;
  }
  .dot {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--bg);
  }
  .dot.on {
    background: var(--fg);
  }
  /* The black dots fill in one diagonal after another, gently. */
  @media (prefers-reduced-motion: no-preference) {
    .dot.on {
      animation: dot-in var(--dur-slow) var(--ease-gentle) backwards;
      animation-delay: calc(var(--d) * 45ms + 150ms);
    }
  }
  @keyframes dot-in {
    from {
      background: var(--bg);
      transform: scale(0.6);
    }
  }
  /* The way out: a black button and a link, centred, 64px under the card. */
  .actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--l);
    margin-top: var(--x3l);
  }
  @media (max-width: 720px) {
    .page {
      padding-top: var(--m);
    }
    .card {
      padding: var(--xl) var(--m);
    }
    .actions {
      margin-top: var(--xl);
    }
  }
</style>
