---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import LibraryControls from '../components/LibraryControls.astro';
import { getPublished } from '../lib/publications';

const pubs = await getPublished();
---

<Base>
  <!-- Apply the remembered view before first paint, so the list view doesn't flash. -->
  <script is:inline slot="head">
    try {
      if (localStorage.getItem('rat:view') === 'list')
        document.documentElement.dataset.view = 'list';
    } catch (e) {}
  </script>

  <div class="wrap" data-lib>
    <div class="intro">
      <h1 class="lede">
        A collection of books, essays, magazines and more about type design, across cultures,
        scripts and languages.
      </h1>
      <p class="count" data-count-total aria-live="polite">
        {pubs.length} publications
      </p>
    </div>

    <LibraryControls pubs={pubs} />

    <ul class="grid" data-grid role="list">
      {pubs.map((pub, i) => (
        <Card pub={pub} index={i} priority={i < 4} />
      ))}
    </ul>

    <div class="empty" data-empty hidden>
      <p class="display">Nothing matches.</p>
      <p>Try fewer filters or another search. Know a publication that fits?</p>
      <p class="empty-actions">
        <button type="button" data-empty-reset>
          Reset filters
        </button>
        <a href="/submit">Submit it</a>
      </p>
    </div>
  </div>
</Base>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px 32px;
    margin-bottom: clamp(20px, 3vw, 32px);
  }
  .lede {
    max-width: 52ch;
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.35;
    color: var(--muted);
  }
  .count {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Columns: 2 up to 1023px · 3 from 1024px to 1920px · 4 above (e.g. 2560px). */
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1921px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  :global(html[data-view='list']) .grid {
    display: block;
    border-top: 1px solid var(--line);
  }
  .empty {
    padding: clamp(32px, 6vw, 80px) 0;
    text-align: center;
  }
  .empty .display {
    font-size: var(--step-2);
    margin-bottom: 8px;
  }
  .empty-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 16px;
  }
  .empty button {
    padding: 10px 18px;
    background: var(--fg);
    color: var(--bg);
    border: 0;
    font-weight: 700;
    cursor: pointer;
  }
  .empty a {
    align-self: center;
  }
</style>
