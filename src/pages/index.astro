---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import LibraryControls from '../components/LibraryControls.astro';
import LibraryTools from '../components/LibraryTools.astro';
import { getPublished, publicationUrl } from '../lib/publications';
import { REPO_URL, SITE_ALT_NAMES, SITE_DESCRIPTION, SITE_NAME, siteIds } from '../lib/seo';

const pubs = await getPublished();

// Structured data: who the site is (its names, so "Read About Type", "Typereads" and
// typereads.xyz are one site) and what this page is (the list of publications).
const site = Astro.site!;
const ids = siteIds(site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': ids.website,
      name: SITE_NAME,
      alternateName: SITE_ALT_NAMES,
      url: site.href,
      description: SITE_DESCRIPTION,
      inLanguage: 'en',
      publisher: { '@id': ids.organization },
    },
    {
      '@type': 'Organization',
      '@id': ids.organization,
      name: SITE_NAME,
      alternateName: SITE_ALT_NAMES,
      url: site.href,
      logo: new URL('/og.png', site).href,
      sameAs: [REPO_URL],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${site.href}#library`,
      url: site.href,
      name: `${SITE_NAME}: publications about type design`,
      description: SITE_DESCRIPTION,
      isPartOf: { '@id': ids.website },
      about: { '@type': 'Thing', name: 'Type design' },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: pubs.length,
        itemListElement: pubs.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: new URL(publicationUrl(p), site).href,
          name: p.data.title,
        })),
      },
    },
  ],
};
---

<Base jsonLd={jsonLd}>
  <!-- Before first paint: apply the remembered view (no list-view flash) and start the
       intro animation (global.css, "Intro"; boot.ts removes the class afterwards). -->
  <script is:inline slot="head">
    document.documentElement.classList.add('is-intro');
    try {
      if (localStorage.getItem('rat:view') === 'list')
        document.documentElement.dataset.view = 'list';
    } catch (e) {}
  </script>

  <LibraryTools slot="header-tools" />

  <div class="wrap lib" data-lib>
    <!-- The project line is in the footer (Figma); the heading stays for screen readers. -->
    <h1 class="visually-hidden">Read About Type: publications about type design</h1>

    <LibraryControls pubs={pubs} />

    <ul class="grid" data-grid role="list">
      {pubs.map((pub, i) => (
        <Card pub={pub} index={i} priority={i < 4} />
      ))}
    </ul>

    <div class="empty" data-empty hidden>
      <p class="t-h2">Nothing matches.</p>
      <p>Try fewer filters or another search. Know a publication that fits?</p>
      <p class="empty-actions">
        <button type="button" data-empty-reset>
          Reset filters
        </button>
        <a href="/submit">Submit it</a>
      </p>
    </div>
  </div>
</Base>

<style>
  /* 64px under the header on desktop (Figma), 16px on phones. */
  .lib {
    position: relative; /* the filter panel opens from its top edge */
    padding-top: var(--x3l);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Columns: 2 up to 1023px, 3 from 1024px to 1920px, 4 above (the page stops
     growing at 2560px). */
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1921px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  :global(html[data-view='list']) .grid {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--m);
  }
  @media (max-width: 720px) {
    .lib {
      padding-top: var(--m);
    }
  }
  .empty {
    padding: clamp(32px, 6vw, 80px) 0;
    text-align: center;
  }
  .empty .t-h2 {
    margin-bottom: var(--xs);
  }
  .empty-actions {
    display: flex;
    justify-content: center;
    gap: var(--m);
    margin-top: var(--m);
  }
  .empty button {
    padding: 10px 18px;
    background: var(--fg);
    color: var(--surface);
    border: 0;
    cursor: pointer;
  }
  .empty a {
    align-self: center;
  }
  .empty[hidden] {
    display: none;
  }
</style>
