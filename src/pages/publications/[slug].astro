---
// Publication detail (Figma "Detail desktop/mobile page", ADR-013): a card with the
// title, type and cover on the publication's colour, then the details on white.
// Only published entries get a page.
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Icon from '../../components/Icon.astro';
import { bgColor, textColorFor } from '../../lib/color';
import {
  availabilityLabel,
  dateLabel,
  formatsLabel,
  isoDate,
  languageName,
  scriptLabel,
  typeLabel,
} from '../../lib/format';
import { getPublished, type Publication } from '../../lib/publications';
import { SCRIPTS } from '../../data/taxonomies';
import { publicationTitle, siteIds, SITE_NAME, summarize } from '../../lib/seo';
import { coverGallery, mainCover, releasesOf } from '../../lib/editions';

export async function getStaticPaths() {
  const pubs = await getPublished();
  return pubs.map((pub) => ({ params: { slug: pub.data.slug }, props: { pub } }));
}

const { pub } = Astro.props as { pub: Publication };
const d = pub.data;
const { Content } = await render(pub);
const bg = bgColor(d.color);
const tc = textColorFor(bg);

// Editions and issues (ADR-014): the newest cover leads; every cover (newest first)
// is in the carousel at the end of the details (Figma "Detail desktop page").
const cover = mainCover(d);
const releases = releasesOf(d);
const hasEditions = d.editions.length > 0;
const gallery = coverGallery(d);
const releaseLine = (r: (typeof releases)[number]) =>
  [`${r.label}, ${dateLabel(r.year, r.date)}`, r.publisher].filter(Boolean).join(' · ');

// Metadata rows (Figma "Detail desktop/mobile page"), only those with a value.
// Labels follow the count: "Author" for one, "Authors" for several. `lines` puts
// each value on its own line (editions, issues) instead of a comma list.
type Row = { label: string; value?: string | string[]; lines?: boolean };
const label = (word: string, n: number) => (n > 1 ? `${word}s` : word);
const rows: Row[] = [
  { label: label('Author', d.authors.length), value: d.authors },
  { label: label('Publisher', d.publishers.length), value: d.publishers },
  { label: 'Part of', value: d.series },
  { label: label('Format', d.formats.length), value: formatsLabel(d.formats) },
  { label: label('Language', d.languages.length), value: d.languages.map(languageName) },
  {
    label: label('Translation', d.translations.length),
    value: d.translations.map((t) =>
      [languageName(t.language), t.title].filter(Boolean).join(': '),
    ),
  },
  hasEditions
    ? { label: 'Editions', value: releases.map(releaseLine), lines: true }
    : { label: 'Publication date', value: dateLabel(d.year, d.date) },
  ...(!hasEditions && d.issues.length
    ? [{ label: label('Issue', d.issues.length), value: releases.map(releaseLine), lines: true }]
    : []),
  { label: label('Script', d.scripts.length), value: d.scripts.map(scriptLabel) },
  { label: 'Availability', value: availabilityLabel(d.availability) },
  { label: 'Pages', value: d.pages ? String(d.pages) : undefined },
].filter((r) => (Array.isArray(r.value) ? r.value.length > 0 : Boolean(r.value)));
// With several editions, each ISBN is named after its edition.
const isbns = hasEditions
  ? releases.filter((r) => r.isbn).map((r) => `${r.isbn} (${r.label})`)
  : d.isbn
    ? [d.isbn]
    : [];
const ids: Row[] = [
  { label: label('ISBN', isbns.length), value: isbns, lines: true },
  { label: 'ISSN', value: d.issn },
].filter((r) => (Array.isArray(r.value) ? r.value.length > 0 : Boolean(r.value)));

const links = [
  { label: 'Publisher website', href: d.links?.publisher },
  { label: 'Read online', href: d.links?.read },
  { label: 'Buy', href: d.links?.buy },
].filter((l): l is { label: string; href: string } => Boolean(l.href));
const [primary, ...secondary] = links;
const hasBody = Boolean(pub.body?.trim());

// Social preview and structured data.
const og = cover ? await getImage({ src: cover, width: 1200, format: 'jpeg' }) : undefined;
const pageUrl = new URL(`/publications/${d.slug}`, Astro.site).href;
const schemaType =
  d.type === 'book' ? 'Book' : d.type === 'magazine' ? 'Periodical' : 'CreativeWork';
const site = siteIds(Astro.site!);
// What the publication is about: type design, and the scripts it covers (general /
// multi-script left out). Helps "books about Arabic type design"-style searches.
const scriptNames = d.scripts.filter((s) => s !== 'Zyyy').map((s) => SCRIPTS[s].label);
const topics = ['Type design', ...scriptNames.map((n) => `${n} script`)];
const longDescription = pub.body?.trim() ? summarize(pub.body, 1000) : undefined;
const publication = {
  '@type': schemaType,
  '@id': `${pageUrl}#publication`,
  name: d.title,
  mainEntityOfPage: pageUrl,
  isPartOf: { '@id': site.website },
  ...(longDescription && { description: longDescription }),
  about: topics.map((name) => ({ '@type': 'Thing', name })),
  keywords: ['type design', 'typography', typeLabel(d.type).toLowerCase(), ...scriptNames].join(
    ', ',
  ),
  // Only digital is certain: "physical" doesn't say hardcover or paperback.
  ...(d.type === 'book' &&
    d.formats.length === 1 &&
    d.formats[0] === 'digital' && { bookFormat: 'https://schema.org/EBook' }),
  ...(d.subtitle && { alternativeHeadline: d.subtitle }),
  url: pageUrl,
  author: d.authors.map((name) => ({ '@type': 'Person', name })),
  ...(d.publishers.length && {
    publisher: d.publishers.map((name) => ({ '@type': 'Organization', name })),
  }),
  datePublished: isoDate(d.year, d.date),
  ...(d.languages.length && { inLanguage: d.languages }),
  ...(d.isbn && { isbn: d.isbn }),
  ...(d.issn && { issn: d.issn }),
  ...(d.pages && { numberOfPages: d.pages }),
  ...(og && { image: new URL(og.src, Astro.site).href }),
  // Editions as examples of the work; issues as its parts (ADR-014).
  ...(hasEditions && {
    workExample: releases.map((r) => ({
      '@type': schemaType,
      name: d.title,
      bookEdition: r.label,
      datePublished: isoDate(r.year, r.date),
      ...(r.isbn && { isbn: r.isbn }),
      ...(r.pages && { numberOfPages: r.pages }),
      ...(r.publisher && { publisher: { '@type': 'Organization', name: r.publisher } }),
    })),
  }),
  ...(!hasEditions &&
    d.issues.length && {
      hasPart: releases.map((r) => ({
        '@type': 'PublicationIssue',
        name: r.label,
        datePublished: isoDate(r.year, r.date),
      })),
    }),
  ...(d.series && {
    isPartOf: [{ '@id': site.website }, { '@type': 'Periodical', name: d.series }],
  }),
  ...(links[0] && { sameAs: links.map((l) => l.href) }),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    publication,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE_NAME, item: Astro.site!.href },
        { '@type': 'ListItem', position: 2, name: d.title, item: pageUrl },
      ],
    },
  ],
};
// Meta description: whole words, with "…" when shortened.
const description = pub.body?.trim() ? summarize(pub.body) : undefined;
---

<Base
  title={publicationTitle(d.title, d.authors)}
  ogTitle={d.title}
  description={description}
  image={og?.src}
  imageAlt={cover ? `Cover of ${d.title}` : undefined}
  ogType={d.type === 'book' ? 'book' : 'website'}
  jsonLd={jsonLd}
>
  <!-- "Home ←" next to the logo; goes back in history when the visitor came from the
       library (boot.ts), so filters and scroll are restored. -->
  <a class="trigger t-caption home" href="/" data-back slot="header-back">
    Home
    <Icon name="back" />
  </a>

  <div class="wrap page">
    <article class="detail" data-detail style={`--c:${bg};--tc:${tc}`}>
      <div class="hero-block" data-hero>
        <header class="head">
          <h1 class="title t-h1">{d.title}</h1>
          <p class="type t-caption">{typeLabel(d.type)}</p>
        </header>
        {d.subtitle && <p class="subtitle t-paragraph">{d.subtitle}</p>}
        <div class="hero">
          <div class="hero-cover">
            <Cover
              pub={pub}
              priority
              alt={`Cover of ${d.title}`}
              widths={[360, 500, 720, 1000, 1300]}
              sizes="(min-width: 721px) 500px, 82vw"
            />
          </div>
        </div>
      </div>

      <div class="panel">
        <dl class="meta">
          {rows.map((r) => (
            <div class="row">
              <dt class="t-caption">{r.label}</dt>
              <dd class="t-paragraph">
                {r.lines && Array.isArray(r.value)
                  ? r.value.map((v) => <span class="line">{v}</span>)
                  : Array.isArray(r.value)
                    ? r.value.join(', ')
                    : r.value}
              </dd>
            </div>
          ))}
          {hasBody && (
            <div class="row stacked">
              <dt class="t-caption">Description</dt>
              <dd class="t-paragraph prose">
                <Content />
              </dd>
            </div>
          )}
          {ids.map((r) => (
            <div class="row">
              <dt class="t-caption">{r.label}</dt>
              <dd class="t-paragraph">
                {Array.isArray(r.value)
                  ? r.value.map((v) => <span class="line">{v}</span>)
                  : r.value}
              </dd>
            </div>
          ))}
          <div class="row actions">
            <dt class="visually-hidden">Links</dt>
            <dd>
              {primary && (
                <a class="button t-paragraph" href={primary.href} target="_blank" rel="noopener">
                  {primary.label}
                  <span class="button-icon" aria-hidden="true">
                    <Icon name="external" class="out" />
                    <Icon name="external" class="in" />
                  </span>
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              )}
              <span class="more t-paragraph">
                {secondary.map((l) => (
                  <a class="u-link" href={l.href} target="_blank" rel="noopener">
                    {l.label}
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                ))}
                <a class="u-link" href={`/submit/fix/${d.slug}`}>
                  Suggest modification
                </a>
              </span>
            </dd>
          </div>
          {d.credit && (
            <div class="row">
              <dt class="t-caption">Submitted by</dt>
              <dd class="t-paragraph">{d.credit}</dd>
            </div>
          )}
        </dl>

        {gallery.length > 0 && (
          <section
            class="gallery"
            aria-roledescription="carousel"
            aria-label={`Covers of ${d.title}`}
            data-gallery
          >
            {/* Scrolls and snaps natively (swipe, trackpad, arrow keys once focused); the
                buttons and caption are added by scripts/covers.ts. */}
            <ul class="strip" role="list" tabindex="0" aria-label="Covers" data-strip>
              {gallery.map((g, i) => (
                <li
                  class="slide"
                  aria-roledescription="slide"
                  aria-label={`${i + 1} of ${gallery.length}: ${g.label}`}
                  data-caption={g.label}
                >
                  <Cover
                    pub={pub}
                    image={g.cover}
                    alt={`Cover of ${d.title}, ${g.label}`}
                    widths={[360, 640, 1000, 1300]}
                    sizes="(min-width: 721px) 640px, 80vw"
                  />
                </li>
              ))}
            </ul>
            <div class="nav" hidden data-gallery-nav>
              <button
                type="button"
                class="step prev"
                aria-label="Previous cover"
                data-prev
                disabled
              >
                <Icon name="arrow-right" />
              </button>
              <p class="caption t-caption" aria-live="polite" data-gallery-caption>
                {gallery[0]!.label}
              </p>
              <button type="button" class="step" aria-label="Next cover" data-next>
                <Icon name="arrow-right" />
              </button>
            </div>
          </section>
        )}
      </div>
    </article>
  </div>
</Base>

<style>
  /* "Home ←" (Figma "Back Home"): a 108px trigger button next to the logo. */
  .home {
    min-width: 108px;
  }
  /* 64px under the header (16px on phones), as on the homepage. */
  .page {
    padding-top: var(--x3l);
  }
  /* No background of its own: the white belongs to the panel, so while the coloured
     block is still arriving (motion layer) nothing white shows behind it. */
  .detail {
    border-radius: var(--radius-l);
    overflow: hidden;
  }

  /* --- The coloured block: title, type, cover ---------------------------- */
  .hero-block {
    background: var(--c);
    color: var(--tc);
  }
  .head {
    display: flex;
    align-items: flex-end;
    gap: var(--l);
    padding: var(--x3l);
  }
  .title {
    flex: 1;
    min-width: 0;
    overflow-wrap: break-word;
  }
  .subtitle {
    margin: calc(-1 * var(--l)) var(--x3l) var(--x3l);
    max-width: 60ch;
    opacity: 0.85;
  }
  .hero {
    display: flex;
    justify-content: center;
    padding: 0 96px 96px;
  }
  /* The cover at a fixed height (644px in Figma), its width from its proportions. */
  .hero-cover :global(img),
  .hero-cover :global(.type-cover) {
    display: block;
    width: auto;
    max-width: 100%;
    height: clamp(320px, 42vw, 644px);
    object-fit: contain;
  }
  .hero-cover :global(.type-cover) {
    aspect-ratio: 2 / 3;
  }
  /* --- Carousel (Figma "Detail desktop page"): square slides as wide as the
     column, the next one peeking in up to the card's edge; then ← caption →. */
  .gallery {
    --col: min(760px, 100cqi);
    --bleed: calc((100cqi - var(--col)) / 2 + var(--pad));
    display: grid;
    gap: var(--xl);
    max-width: 760px;
    margin: 0 auto;
    padding: var(--xl) 0;
    border-bottom: 1px solid var(--fg);
  }
  .strip {
    display: flex;
    gap: var(--m);
    margin: 0 calc(-1 * var(--bleed)) 0 0;
    padding: 0 var(--bleed) 0 0; /* lets the last slide reach the column's start */
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  .strip:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
  .slide {
    flex: 0 0 var(--col);
    aspect-ratio: 1;
    padding: calc(var(--col) * 0.08);
    background: var(--c);
    color: var(--tc);
    scroll-snap-align: start;
  }
  .slide :global(picture) {
    display: contents;
  }
  .slide :global(img),
  .slide :global(.type-cover) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .nav {
    display: grid;
    grid-template-columns: 53px minmax(0, 1fr) 53px;
    align-items: center;
    gap: var(--m);
  }
  .nav[hidden] {
    display: none;
  }
  .caption {
    margin: 0;
    text-align: center;
  }
  /* Figma "Icons S" in a 53px bordered square; at either end the arrow is hidden. */
  .step {
    display: grid;
    place-items: center;
    width: 53px;
    height: 53px;
    padding: 0;
    background: none;
    color: var(--fg);
    border: 1px solid var(--fg);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .prev :global(svg) {
    transform: scaleX(-1);
  }
  .step:disabled {
    cursor: default;
  }
  .step:disabled :global(svg) {
    visibility: hidden;
  }
  @media (hover: hover) {
    .step:not(:disabled):hover {
      background: var(--fg);
      color: var(--surface);
    }
  }
  .step:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* Editions, issues and ISBNs: one per line. */
  .line {
    display: block;
  }

  /* --- The details on white ------------------------------------------------ */
  .panel {
    --pad: var(--l);
    container-type: inline-size; /* the carousel bleeds to the card's right edge */
    padding: 96px var(--pad);
    background: var(--surface);
    color: var(--fg);
  }
  .meta {
    max-width: 760px;
    margin: 0 auto;
    border-bottom: 1px solid var(--fg);
  }
  .row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    align-items: baseline;
    padding: var(--xl) 0;
    border-top: 1px solid var(--fg);
  }
  dd {
    margin: 0;
  }
  .prose :global(p + p) {
    margin-top: 1em;
  }
  .prose :global(a) {
    text-underline-offset: 3px;
  }
  .actions dd {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--m) var(--l);
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--m) var(--l);
    margin-left: auto;
  }

  /* "Button Primary": black, white text, an arrow that slips out and back in. */
  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--xs);
    height: 48px;
    padding: 0 var(--s) 0 var(--m);
    background: var(--fg);
    color: var(--surface);
    text-decoration: none;
  }
  .button-icon {
    position: relative;
    width: 19px;
    height: 19px;
    overflow: hidden;
  }
  .button-icon :global(svg) {
    position: absolute;
    inset: 0;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .button-icon :global(.in) {
    transform: translate(-100%, 100%);
  }
  @media (hover: hover) {
    .button:hover .button-icon :global(.out) {
      transform: translate(100%, -100%);
    }
    .button:hover .button-icon :global(.in) {
      transform: none;
    }
  }

  /* --- Phones --------------------------------------------------------------- */
  @media (max-width: 720px) {
    .page {
      padding-top: var(--m);
    }
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--m);
      padding: var(--m) var(--m) var(--xl);
    }
    .subtitle {
      margin: calc(-1 * var(--m)) var(--m) var(--xl);
    }
    .hero {
      padding: 0 var(--xl) var(--xl);
    }
    /* Full width from the first frame: an image at width: 100% in a box sized by its
       content is 0 wide until it loads, and the card -> detail transition measures
       the cover before that (it flew to a 0 × 0 target in a short block). */
    .hero-cover {
      width: 100%;
    }

    .hero-cover :global(img),
    .hero-cover :global(.type-cover) {
      width: 100%;
      height: auto;
    }
    .panel {
      --pad: var(--m);
      padding: var(--l) var(--pad);
    }
    /* No rule under the last row on phones: the carousel draws its own above. */
    .gallery {
      gap: var(--l);
      padding: var(--l) 0;
      border-top: 1px solid var(--fg);
    }
    .meta {
      border-bottom: 0;
    }
    .row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--xs);
      padding: var(--l) 0;
      border-top: 0;
      border-bottom: 1px solid var(--fg);
    }
    .row:first-child {
      padding-top: 0;
    }
    .row.stacked {
      grid-template-columns: 1fr;
      gap: var(--m);
    }
    .actions dd {
      flex-direction: column;
      align-items: stretch;
      gap: var(--l);
    }
    .button {
      justify-content: center;
    }
    .more {
      justify-content: center;
      margin-left: 0;
    }
  }
</style>
