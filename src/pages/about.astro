---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(about);
const { title, intro, faq, contact } = about.data;
---

<Base title="About" description={intro}>
  <div class="wrap narrow">
    <h1 class="display h1">{title}</h1>
    {intro && <p class="intro">{intro}</p>}

    {faq.length > 0 && (
      <section aria-labelledby="faq">
        <h2 id="faq" class="display h2">
          Questions you may have
        </h2>
        <div class="faq">
          {faq.map((item) => (
            <details>
              <summary>
                <span>{item.question}</span>
              </summary>
              <div class="answer">
                <Prose text={item.answer} />
              </div>
            </details>
          ))}
        </div>
        {contact && (
          <p class="contact">
            Still have questions? Write to <a href={`mailto:${contact}`}>{contact}</a>.
          </p>
        )}
      </section>
    )}

    <div class="body">
      <Content />
    </div>
  </div>
</Base>

<style>
  .narrow {
    max-width: 760px;
  }
  .h1 {
    font-size: var(--step-3);
    margin-top: clamp(16px, 4vw, 48px);
  }
  .intro {
    margin-top: 16px;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .h2,
  .body :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.1;
    margin: clamp(36px, 6vw, 64px) 0 16px;
  }
  .faq {
    display: grid;
    gap: 8px;
  }
  details {
    background: var(--surface);
  }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '↓';
    transition: transform var(--dur-base) var(--ease-out);
  }
  details[open] summary::after {
    transform: rotate(180deg);
  }
  .answer {
    padding: 0 20px 20px;
    color: color-mix(in srgb, var(--fg) 85%, transparent);
  }
  .answer :global(p + p),
  .answer :global(p + ul) {
    margin-top: 12px;
  }
  .answer :global(ul) {
    margin: 0;
    padding-left: 1.2em;
  }
  .contact {
    margin-top: 16px;
    color: var(--muted);
  }
  .body :global(p) {
    margin-top: 12px;
    line-height: 1.6;
  }
  .body :global(a) {
    text-underline-offset: 3px;
  }
</style>
