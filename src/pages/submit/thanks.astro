---
import Base from '../../layouts/Base.astro';
---

<Base title="Thank you" noindex>
  <div class="wrap narrow">
    <h1 class="display h1">Thank you!</h1>
    <p class="intro">
      Your message is in. I review every submission by hand; accepted titles usually appear within a
      month. If you left an email, I may write back with a question.
    </p>
    <p class="links">
      <a href="/">Back to the library</a> · <a href="/submit">Suggest another</a>
    </p>
  </div>
</Base>

<style>
  .narrow {
    max-width: 720px;
  }
  .h1 {
    font-size: var(--step-3);
    margin-top: clamp(16px, 4vw, 48px);
  }
  .intro {
    margin-top: 16px;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .links {
    margin-top: 24px;
  }
</style>
