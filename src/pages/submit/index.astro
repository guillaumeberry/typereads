---
// Submission page (ADR-005): for direct links and visitors without JavaScript. With JS,
// the header's "+" opens the same form in a panel (SubmitPanel.astro) instead. Styled
// as the panel (Figma "Submission Form Panel"): a white card, 640px wide.
import Base from '../../layouts/Base.astro';
import SubmitForm from '../../components/SubmitForm.astro';
---

<Base
  title="Submit a publication"
  description="Suggest a book, magazine or website about type design for the library."
>
  <div class="wrap page">
    <div class="card">
      <h1 class="t-h2">Submit a publication</h1>
      <p class="t-paragraph">
        You know a publication (or more) about type design that belongs here? Tell me about it! I’ll
        review every submission individually.
      </p>
      <SubmitForm id="page" />
    </div>
  </div>
</Base>

<style>
  .page {
    padding-top: var(--x3l);
  }
  .card {
    display: grid;
    gap: var(--xxl);
    max-width: 640px;
    margin-inline: auto;
    padding: var(--xl);
    background: var(--surface);
  }
  @media (max-width: 720px) {
    .page {
      padding-top: var(--m);
    }
    .card {
      gap: var(--l);
      padding: var(--l);
    }
  }
</style>
