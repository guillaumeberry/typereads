---
// Submission form (ADR-005). The form itself is shared with the correction pages.
import Base from '../../layouts/Base.astro';
import SubmitForm from '../../components/SubmitForm.astro';
---

<Base
  title="Submit a publication"
  description="Suggest a book, magazine or website about type design for the library."
>
  <div class="wrap narrow">
    <h1 class="display h1">Submit a publication</h1>
    <p class="intro">
      Know a publication about type design that belongs here? Tell me about it. I review every
      submission by hand.
    </p>
    <SubmitForm />
  </div>
</Base>

<style>
  .narrow {
    max-width: 720px;
  }
  .h1 {
    font-size: var(--step-3);
    margin-top: clamp(16px, 4vw, 48px);
  }
  .intro {
    margin-top: 16px;
    font-size: var(--step-1);
    line-height: 1.45;
  }
</style>
