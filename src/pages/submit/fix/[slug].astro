---
// Correction form for one publication (linked from its page). Static, one per entry,
// so it works without JavaScript; the correction is emailed, never committed. Styled
// like the submission panel (a white card).
import Base from '../../../layouts/Base.astro';
import SubmitForm from '../../../components/SubmitForm.astro';
import { getPublished, publicationUrl, type Publication } from '../../../lib/publications';

export async function getStaticPaths() {
  const pubs = await getPublished();
  return pubs.map((pub) => ({ params: { slug: pub.data.slug }, props: { pub } }));
}
const { pub } = Astro.props as { pub: Publication };
---

<Base title={`Suggest a correction: ${pub.data.title}`} noindex>
  <div class="wrap page">
    <div class="card">
      <h1 class="t-h2">Suggest a modification</h1>
      <p class="t-paragraph">
        Spotted a mistake or something missing? Tell me what should change in:
      </p>
      <p class="t-paragraph pub">
        <a class="u-link" href={publicationUrl(pub)}>
          {pub.data.title}
        </a>
      </p>
      <SubmitForm id="fix" fix={{ slug: pub.data.slug, title: pub.data.title }} />
    </div>
  </div>
</Base>

<style>
  .page {
    padding-top: var(--x3l);
  }
  .card {
    display: grid;
    gap: var(--xxl);
    max-width: 640px;
    margin-inline: auto;
    padding: var(--xl);
    background: var(--surface);
  }
  /* The publication's title sits right under the sentence that introduces it. */
  .pub {
    margin-top: calc(var(--m) - var(--xxl));
  }
  @media (max-width: 720px) {
    .pub {
      margin-top: calc(var(--xs) - var(--l));
    }
    .page {
      padding-top: var(--m);
    }
    .card {
      gap: var(--l);
      padding: var(--l);
    }
  }
</style>
