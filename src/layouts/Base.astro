---
// Shared page shell: meta/OG, fonts, skip link, header, footer. Works without JS.
import '@fontsource-variable/archivo/wght.css';
import '@fontsource/archivo-narrow/latin-700.css';
import '../styles/global.css';
import textFont from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import displayFont from '@fontsource/archivo-narrow/files/archivo-narrow-latin-700-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative URL of the social preview image. */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'book' | 'article';
  /** Structured data object(s), serialised as JSON-LD. */
  jsonLd?: object | object[];
  noindex?: boolean;
}

const SITE_NAME = 'Read About Type';
const {
  title,
  description = 'A curated library of books, magazines and websites about type design, across cultures, scripts and languages.',
  image,
  imageAlt,
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const fullTitle = title
  ? `${title} — ${SITE_NAME}`
  : `${SITE_NAME}: publications about type design`;
// Pages are built as files (about.html) but served at clean URLs (/about).
const cleanPath =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '')
    .replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
// Escape "<" so a value can never close the script element.
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1a1a1a" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />

    {ld && <script type="application/ld+json" set:html={ld} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <!-- Announces page changes made by the client router to screen readers. -->
    <div class="visually-hidden" aria-live="polite" data-announcer></div>
    <script>
      import '../scripts/boot';
    </script>
  </body>
</html>
