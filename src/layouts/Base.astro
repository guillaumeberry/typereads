---
// Shared page shell: meta/OG, fonts, skip link, header, footer. Works without JS.
import '@fontsource-variable/archivo/wght.css';
import '@fontsource/archivo-narrow/latin-700.css';
import '../styles/global.css';
import textFont from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import displayFont from '@fontsource/archivo-narrow/files/archivo-narrow-latin-700-normal.woff2?url';
import { existsSync } from 'node:fs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SubmitPanel from '../components/SubmitPanel.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '../lib/seo';

interface Props {
  title?: string;
  /** Title for social previews, when it should differ from the page title. */
  ogTitle?: string;
  description?: string;
  /** Absolute or root-relative URL of the social preview image. */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'book' | 'article';
  /** Structured data object(s), serialised as JSON-LD. */
  jsonLd?: object | object[];
  noindex?: boolean;
}

// HEX Franklin (licensed) when scripts/fonts.mjs found the files; Archivo otherwise.
const HEX = ['regular', 'bold'].every((w) => existsSync(`public/fonts/hex-franklin-${w}.woff2`));
// Light (titles) is optional: without it, browsers use Regular for weight 300.
const HEX_LIGHT = HEX && existsSync('public/fonts/hex-franklin-light.woff2');
const hexFaces = `${HEX_LIGHT ? "@font-face { font-family: 'HEX Franklin'; src: url('/fonts/hex-franklin-light.woff2') format('woff2'); font-weight: 300; font-style: normal; font-display: swap; }" : ''}
@font-face { font-family: 'HEX Franklin'; src: url('/fonts/hex-franklin-regular.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
@font-face { font-family: 'HEX Franklin'; src: url('/fonts/hex-franklin-bold.woff2') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
/* html:root outranks global.css's :root, whatever the order in <head>. */
html:root {
  --font-text: 'HEX Franklin', 'Archivo Fallback', system-ui, sans-serif;
  --font-display: 'HEX Franklin', 'Archivo Fallback', system-ui, sans-serif;
}`;
const {
  title,
  ogTitle = title,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const fullTitle = title
  ? `${title} — ${SITE_NAME}`
  : `${SITE_NAME}: publications about type design`;
// Pages are built as files (about.html) but served at clean URLs (/about).
const cleanPath =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '')
    .replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site);
// Pages without an image of their own share the site's card (public/og.png:
// the logo and the shelf of books, 1200 × 630).
const ownImage = Boolean(image);
const imageUrl = new URL(image ?? '/og.png', Astro.site).href;
const imageAltText = ownImage ? imageAlt : `${SITE_NAME}: publications about type design`;
// Escape "<" so a value can never close the script element.
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* A page kept out of search (404, correction forms) has no canonical URL. */}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {HEX ? (
      <>
        <link
          rel="preload"
          href="/fonts/hex-franklin-regular.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
        {HEX_LIGHT && (
          <link
            rel="preload"
            href="/fonts/hex-franklin-light.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
        )}
        <style is:inline set:html={hexFaces} />
      </>
    ) : (
      <>
        <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
      </>
    )}
    {/* The "T" mark (assets/favicon/): black on light browser themes, white on dark
         ones; the touch icon for iOS home screens. */}
    <link
      rel="icon"
      href="/favicon-light.png"
      type="image/png"
      sizes="16x16"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      href="/favicon-dark.png"
      type="image/png"
      sizes="16x16"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#e7e8ef" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={ogTitle ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {!ownImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    {imageAltText && <meta property="og:image:alt" content={imageAltText} />}
    <meta name="twitter:card" content="summary_large_image" />

    {ld && <script type="application/ld+json" set:html={ld} />}
    {/* Cabin analytics (ADR-008): cookie-free pageviews; it follows pushState, so the
         motion router's page changes count too. Production builds only. Allowed in the
         CSP (public/_headers): scripts.withcabin.com, ping.withcabin.com. */}
    {import.meta.env.PROD && (
      <script is:inline src="https://scripts.withcabin.com/hello.js" async defer />
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header>
      <slot name="header-back" slot="back" />
      <slot name="header-tools" slot="tools" />
    </Header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <!-- The submission panel, opened by "+" (outside <main>: survives page changes). -->
    <SubmitPanel />
    <!-- Announces page changes made by the client router to screen readers. -->
    <div class="visually-hidden" aria-live="polite" data-announcer></div>
    <script>
      import '../scripts/boot';
    </script>
  </body>
</html>
