---
// A publication cover on its colour, or a typographic cover when no image exists,
// so there is never a broken image.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Publication } from '../lib/publications';
import { mainCover } from '../lib/editions';

interface Props {
  pub: Publication;
  /** Responsive `sizes` for the image. */
  sizes: string;
  widths: number[];
  /** Above the fold: load eagerly with high priority. */
  priority?: boolean;
  alt?: string;
  /** A specific cover (an edition's, in the detail page's gallery). Default: the
   *  newest edition or issue cover, else the publication's own (ADR-014). */
  image?: ImageMetadata;
}
const { pub, sizes, widths, priority = false, alt = '', image } = Astro.props;
const { title } = pub.data;
const cover = image ?? mainCover(pub.data);
---

{cover ? (
  <Picture
    src={cover}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpeg"
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
    class="cover-img"
  />
) : (
  <div class="type-cover display" role={alt ? 'img' : undefined} aria-label={alt || undefined}>
    <span>{title}</span>
  </div>
)}

<style>
  .type-cover {
    aspect-ratio: 2 / 3;
    width: 100%;
    display: flex;
    align-items: flex-end;
    padding: 12%;
    background: color-mix(in srgb, currentColor 8%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    font-size: clamp(1rem, 0.6rem + 1.4vw, 1.75rem);
    overflow-wrap: anywhere;
  }
</style>
