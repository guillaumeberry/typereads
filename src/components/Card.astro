---
// One publication in the library (Figma "Grid item" and "List item"). The same
// markup serves both views:
// - grid: the cover on its colour, nothing else (the text is kept for screen
//   readers); on hover (Figma "Grid item / Hover") the tile darkens, the cover slides
//   down, the title and type appear in white at the top and an arrow disc rises in;
// - list: a white row with the cover tile, title, authors, publisher, type,
//   format and year (two text lines under the title on phones).
// Data attributes feed the client-side filters (src/scripts/library.ts).
import Cover from './Cover.astro';
import Icon from './Icon.astro';
import { bgColor, textColorFor } from '../lib/color';
import { formatsLabel, typeLabel } from '../lib/format';
import { publicationUrl, type Publication } from '../lib/publications';
import { normalize } from '../scripts/library-core';

interface Props {
  pub: Publication;
  index: number;
  priority?: boolean;
}
const { pub, index, priority = false } = Astro.props;
const d = pub.data;
const bg = bgColor(d.color);
const searchText = normalize(
  [d.title, d.subtitle, ...d.authors, ...d.publishers, d.isbn, d.issn].filter(Boolean).join(' '),
);
const publisher = d.publishers.join(', ');
---

<li
  class="card"
  data-id={d.slug}
  data-i={index}
  data-title={d.title}
  data-type={d.type}
  data-formats={d.formats.join(' ')}
  data-langs={d.languages.join(' ')}
  data-tlangs={d.translations.map((t) => t.language).join(' ')}
  data-scripts={d.scripts.join(' ')}
  data-year={d.year}
  data-avail={d.availability}
  data-s={searchText}
>
  <a href={publicationUrl(pub)} style={`--c:${bg};--tc:${textColorFor(bg)}`}>
    <div class="tile">
      <Cover
        pub={pub}
        priority={priority}
        widths={[300, 450, 600, 900]}
        sizes="(min-width: 1921px) min(24vw, 620px), (min-width: 1024px) 31vw, 46vw"
      />
      <span class="peek" aria-hidden="true">
        <span class="peek-title">{d.title}</span>
        <span class="peek-type">{typeLabel(d.type)}</span>
      </span>
      <span class="arrow" aria-hidden="true">
        <Icon name="arrow" />
      </span>
    </div>
    <div class="caption">
      <h2 class="title t-h2">{d.title}</h2>
      <p class="authors t-paragraph">{d.authors.join(', ')}</p>
      <p class="meta t-caption">
        {publisher && <span class="pub">{publisher}</span>}
        <span class="kind">
          <span class="type">{typeLabel(d.type)}</span>
          <span class="sep" aria-hidden="true">
            -
          </span>
          <span class="formats">{formatsLabel(d.formats)}</span>
          <span class="sep" aria-hidden="true">
            -
          </span>
          <span class="year">{d.year}</span>
        </span>
      </p>
    </div>
  </a>
</li>

<style>
  .card[hidden] {
    display: none;
  }
  .card a {
    position: relative;
    display: block;
    color: var(--fg);
    text-decoration: none;
    border-radius: var(--radius-l);
  }

  /* --- Tile: the cover on its colour -------------------------------------- */
  .tile {
    position: relative;
    aspect-ratio: 1;
    background: var(--c);
    color: var(--tc);
    border-radius: var(--radius-l);
    overflow: hidden;
    container-type: inline-size; /* cqi: hover sizes scale with the tile (Figma: 501px) */
  }
  /* The cover fits inside the square, whatever its proportions (40px of 501). */
  .tile :global(img),
  .tile :global(.type-cover) {
    position: absolute;
    inset: 8%;
    width: 84%;
    height: 84%;
    object-fit: contain;
  }
  .tile :global(.type-cover) {
    aspect-ratio: auto;
  }
  /* Hover (Figma "Grid item / Hover", 501px tile): a 50% multiply overlay, the cover
     slides down 126px, title and type appear 32px from the top, and the arrow disc
     rises to 30px from the corner. Sizes are in cqi so smaller tiles scale down. */
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--fg);
    mix-blend-mode: multiply;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    pointer-events: none;
  }
  .tile :global(img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .peek {
    position: absolute;
    inset: 6.4cqi 6.4cqi auto;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 6.4cqi;
    color: #ffffff;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
    pointer-events: none;
  }
  .peek-title {
    flex: 1;
    min-width: 0;
    font-size: min(var(--h2), 6.4cqi);
    font-weight: 300;
    line-height: 1.2;
    text-wrap: balance;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .peek-type {
    font-size: min(var(--caption), 2.8cqi);
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-top: 0.45em;
  }
  .arrow {
    position: absolute;
    right: 6cqi;
    bottom: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    padding: var(--xs);
    border-radius: 50%;
    background: var(--surface);
    color: var(--fg);
    transform: translateY(calc(100% + 16px));
    transition: transform var(--dur-slow) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    :global(html:not([data-view='list'])) a:hover .tile::after {
      opacity: 0.5;
    }
    :global(html:not([data-view='list'])) a:hover .tile :global(img) {
      transform: translateY(25cqi);
    }
    :global(html:not([data-view='list'])) a:hover .peek {
      opacity: 1;
      transform: none;
    }
    a:hover .arrow {
      transform: translateY(-6cqi);
    }
  }
  a:focus-visible .arrow {
    transform: translateY(-6cqi);
  }
  @media (hover: none) {
    .arrow,
    .peek {
      display: none;
    }
  }
  /* Tier 1: below the first screen, each card (tile or row) fades and rises in as it
     scrolls into view (off the main thread). On the card's link, not the <li>, so it
     never fights the Flip transforms; cards already on screen are at their end state. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .card > a {
        animation: card-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
  :global(.is-flipping) .card > a {
    animation: none;
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  /* --- Grid view: the cover only (text stays for screen readers) ---------- */
  :global(html:not([data-view='list'])) .caption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .tile :global(img),
    .tile :global(.type-cover) {
      inset: 9%;
      width: 82%;
      height: 82%;
    }
  }

  /* --- List view: a white row ----------------------------------------------- */
  :global(html[data-view='list']) .card a {
    display: grid;
    grid-template-columns: clamp(140px, 15.2vw, 243px) minmax(0, 1fr);
    align-items: center;
    gap: var(--m);
    background: var(--surface);
    overflow: hidden;
  }
  :global(html[data-view='list']) .tile {
    border-radius: 0;
  }
  :global(html[data-view='list']) .tile :global(img) {
    inset: var(--m);
    width: calc(100% - 2 * var(--m));
    height: calc(100% - 2 * var(--m));
  }
  /* List hover (Figma "List item / Desktop Hover"): the cover darkens by half and the
     arrow rises to the centre of the tile. */
  :global(html[data-view='list']) .peek {
    display: none;
  }
  :global(html[data-view='list']) .arrow {
    right: auto;
    left: 50%;
    margin-left: -32px;
  }
  @media (hover: hover) and (pointer: fine) {
    :global(html[data-view='list']) a:hover .tile::after {
      opacity: 0.5;
    }
    :global(html[data-view='list']) a:hover .arrow {
      transform: translateY(calc(32px - 50cqi));
    }
  }
  :global(html[data-view='list']) a:focus-visible .arrow {
    transform: translateY(calc(32px - 50cqi));
  }
  /* Desktop row: title over authors | publisher, type, format | year. */
  :global(html[data-view='list']) .caption {
    display: grid;
    grid-template-columns: minmax(0, 758fr) minmax(0, 371fr) minmax(0, 113fr);
    grid-template-rows: 1fr auto auto auto;
    column-gap: var(--m);
    row-gap: 14px;
    min-height: 128px;
  }
  :global(html[data-view='list']) .title {
    grid-area: 1 / 1;
  }
  :global(html[data-view='list']) .authors {
    grid-area: 2 / 1 / 5 / 2;
    align-self: end;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  :global(html[data-view='list']) .meta,
  :global(html[data-view='list']) .kind {
    display: contents;
  }
  :global(html[data-view='list']) .pub {
    grid-area: 2 / 2;
  }
  :global(html[data-view='list']) .type {
    grid-area: 3 / 2;
  }
  :global(html[data-view='list']) .formats {
    grid-area: 4 / 2;
  }
  :global(html[data-view='list']) .year {
    grid-area: 4 / 3;
    font-variant-numeric: tabular-nums;
  }
  :global(html[data-view='list']) .sep {
    display: none;
  }
  /* Lines that end in "…" clip their overflow; with trimmed text boxes that would
     cut descenders, so the clip box gets room below without moving anything. */
  :global(html[data-view='list']) :is(.title, .authors, .pub, .type, .formats) {
    padding-bottom: 0.3em;
    margin-bottom: -0.3em;
  }
  :global(html[data-view='list']) .pub,
  :global(html[data-view='list']) .type,
  :global(html[data-view='list']) .formats {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Phones: a 64px colour strip with the cover, then title and two caption lines. */
  @media (max-width: 720px) {
    :global(html[data-view='list']) .card a {
      grid-template-columns: 64px minmax(0, 1fr);
      align-items: stretch;
      gap: 0;
    }
    :global(html[data-view='list']) .tile {
      aspect-ratio: auto;
      min-height: 96px;
    }
    :global(html[data-view='list']) .tile :global(img) {
      inset: var(--s);
      width: calc(100% - 2 * var(--s));
      height: auto;
      max-height: calc(100% - 2 * var(--s));
      object-position: top;
    }
    :global(html[data-view='list']) .caption {
      display: flex;
      flex-direction: column;
      gap: var(--xs);
      min-height: 0;
      padding: var(--s);
    }
    /* Just enough room for descenders, not for the next (clamped) line. */
    :global(html[data-view='list']) .title {
      padding-bottom: 0.2em;
      margin-bottom: calc(var(--xs) - 0.2em);
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
    }
    /* Authors become a caption line. */
    :global(html[data-view='list']) .authors {
      display: block;
      align-self: stretch;
      font-size: var(--caption);
      line-height: 1;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    :global(html[data-view='list']) .meta {
      display: flex;
      flex-direction: column;
      gap: var(--xs);
    }
    :global(html[data-view='list']) .kind {
      display: flex;
      flex-wrap: wrap;
      gap: var(--xxs);
    }
    /* Flex items don't inherit the parent's text-box trim: set it on each line. */
    :global(html[data-view='list']) :is(.pub, .kind > span) {
      text-box: trim-both cap alphabetic;
    }
    :global(html[data-view='list']) .sep {
      display: inline;
    }
    :global(html[data-view='list']) .pub,
    :global(html[data-view='list']) .type,
    :global(html[data-view='list']) .formats,
    :global(html[data-view='list']) .year {
      grid-area: auto;
    }
  }
</style>
