---
// One publication in the library. The same markup serves both views:
// - grid: cover tile on its colour; title and type/format on hover (pointer) or
//   under the tile (touch);
// - list: a row with a small cover, title, authors, year, type, languages, format.
// Data attributes feed the client-side filters (src/scripts/library.ts).
import Cover from './Cover.astro';
import { bgColor, textColorFor } from '../lib/color';
import { formatsLabel, languageName, typeLabel } from '../lib/format';
import { publicationUrl, type Publication } from '../lib/publications';
import { normalize } from '../scripts/library-core';

interface Props {
  pub: Publication;
  index: number;
  priority?: boolean;
}
const { pub, index, priority = false } = Astro.props;
const d = pub.data;
const bg = bgColor(d.color);
const searchText = normalize(
  [d.title, d.subtitle, ...d.authors, ...d.publishers, d.isbn, d.issn].filter(Boolean).join(' '),
);
const langs = d.languages.map(languageName).join(', ');
---

<li
  class="card"
  data-id={d.slug}
  data-i={index}
  data-title={d.title}
  data-type={d.type}
  data-formats={d.formats.join(' ')}
  data-langs={d.languages.join(' ')}
  data-tlangs={d.translations.map((t) => t.language).join(' ')}
  data-scripts={d.scripts.join(' ')}
  data-year={d.year}
  data-avail={d.availability}
  data-s={searchText}
>
  <a href={publicationUrl(pub)} style={`--c:${bg};--tc:${textColorFor(bg)}`}>
    <div class="tile">
      <Cover
        pub={pub}
        priority={priority}
        widths={[200, 300, 400, 600]}
        sizes="(min-width: 1680px) 260px, (min-width: 1200px) 16vw, (min-width: 720px) 23vw, 36vw"
      />
    </div>
    <div class="caption">
      <h2 class="display title">{d.title}</h2>
      <p class="label meta">
        {typeLabel(d.type)} • {formatsLabel(d.formats)}
      </p>
      <p class="col authors">{d.authors.join(', ')}</p>
      <p class="col year">{d.year}</p>
      <p class="col type">{typeLabel(d.type)}</p>
      <p class="col langs">{langs || '—'}</p>
      <p class="col formats">{formatsLabel(d.formats)}</p>
    </div>
  </a>
</li>

<style>
  .card[hidden] {
    display: none;
  }
  .card a {
    position: relative;
    display: block;
    text-decoration: none;
    color: var(--fg);
  }
  .tile {
    position: relative;
    aspect-ratio: 1;
    background: var(--c);
    color: var(--tc);
    overflow: hidden;
  }
  /* The cover fits inside the square, whatever its proportions. */
  .tile :global(img),
  .tile :global(.type-cover) {
    position: absolute;
    inset: 9% 12%;
    width: 76%;
    height: 82%;
    object-fit: contain;
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 0.3));
  }
  .tile :global(.type-cover) {
    aspect-ratio: auto;
    filter: none;
  }
  /* Tier 1: tiles rise in as they enter the viewport (off the main thread). The
     reveal is on the tile, not the card, so it never fights the Flip transforms. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tile {
        animation: tile-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 35%;
      }
    }
  }
  :global(.is-flipping) .tile {
    animation: none;
  }
  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.97);
    }
  }
  .caption {
    padding-top: 10px;
  }
  .title {
    font-size: var(--step-1);
  }
  .meta {
    margin-top: 4px;
    color: var(--muted);
  }
  .col {
    display: none;
  }

  /* Grid view on pointer devices: caption overlays the tile on hover/focus. */
  @media (hover: hover) and (pointer: fine) {
    :global(html:not([data-view='list'])) .caption {
      position: absolute;
      inset: auto 0 0 0;
      padding: 48px 16px 14px;
      background: linear-gradient(to top, rgb(0 0 0 / 0.78), transparent);
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity var(--dur-base) var(--ease-out),
        transform var(--dur-base) var(--ease-out);
    }
    :global(html:not([data-view='list'])) .meta {
      color: rgb(255 255 255 / 0.8);
    }
    .tile :global(img) {
      transition:
        transform var(--dur-slow) var(--spring),
        filter var(--dur-slow) var(--ease-out);
    }
    a:hover .caption,
    a:focus-visible .caption {
      opacity: 1;
      transform: none;
    }
    :global(html:not([data-view='list'])) a:hover .tile :global(img),
    :global(html:not([data-view='list'])) a:focus-visible .tile :global(img) {
      transform: translateY(-4px) scale(1.02);
      filter: drop-shadow(0 14px 24px rgb(0 0 0 / 0.4));
    }
  }

  /* List view: one dense row per publication. */
  :global(html[data-view='list']) .card a {
    display: grid;
    grid-template-columns:
      56px minmax(0, 2.4fr) minmax(0, 1.6fr) 4ch minmax(0, 0.9fr) minmax(0, 0.9fr)
      minmax(0, 0.9fr);
    gap: 16px;
    align-items: center;
    padding-block: 8px;
    border-bottom: 1px solid var(--line);
  }
  :global(html[data-view='list']) .tile :global(img) {
    inset: 8%;
    width: 84%;
    height: 84%;
    filter: none;
  }
  :global(html[data-view='list']) .caption {
    display: contents;
  }
  :global(html[data-view='list']) .title {
    font-size: var(--step-0);
    font-family: var(--font-text);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.3;
  }
  :global(html[data-view='list']) .meta {
    display: none;
  }
  :global(html[data-view='list']) .col {
    display: block;
    color: var(--muted);
    font-size: var(--step--1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(html[data-view='list']) .year {
    font-variant-numeric: tabular-nums;
  }
  :global(html[data-view='list']) a:hover .title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Mobile list: two lines (title, then authors · year). */
  @media (max-width: 720px) {
    :global(html[data-view='list']) .card a {
      grid-template-columns: 48px minmax(0, 1fr) auto;
      grid-template-areas: 'thumb title year' 'thumb authors authors';
      gap: 2px 12px;
    }
    :global(html[data-view='list']) .tile {
      grid-area: thumb;
    }
    :global(html[data-view='list']) .title {
      grid-area: title;
    }
    :global(html[data-view='list']) .authors {
      grid-area: authors;
    }
    :global(html[data-view='list']) .year {
      grid-area: year;
    }
    :global(html[data-view='list']) .type,
    :global(html[data-view='list']) .langs,
    :global(html[data-view='list']) .formats {
      display: none;
    }
  }
</style>
