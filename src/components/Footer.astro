---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="display title">Publications about Type Design</p>
      <p class="muted">
        A collection of books, essays, magazines and more about type design: theories, history,
        monographs, tools and techniques, technologies.
      </p>
      <p>
        <a href="/submit" class="cta">
          Submit a publication →
        </a>
      </p>
    </div>
    <div class="small">
      <p class="label muted">Licences</p>
      <p>
        Code <a href="https://github.com/guillaumeberry/typereads/blob/main/LICENSE">MIT</a> · Data{' '}
        <a href="https://github.com/guillaumeberry/typereads/blob/main/LICENSE-CONTENT.md">
          CC BY 4.0
        </a>{' '}
        · Covers © their publishers
      </p>
      <p>
        <a href="https://github.com/guillaumeberry/typereads">Source on GitHub</a>
      </p>
    </div>
    <p class="label muted credit">A project cooked by Guillaume Berry · {year}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(48px, 8vw, 120px);
    border-top: 1px solid var(--line);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 24px 48px;
    padding-block: 40px;
  }
  .title {
    font-size: var(--step-2);
    margin-bottom: 8px;
  }
  .muted {
    color: var(--muted);
  }
  p + p {
    margin-top: 8px;
  }
  .small {
    font-size: var(--step--1);
  }
  .cta {
    font-weight: 700;
  }
  .credit {
    grid-column: 1 / -1;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
