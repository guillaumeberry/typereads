---
// Site footer (Figma "Footer": on all pages): a shelf of books in the cover colours,
// the project line with a link to About, and "Back to top".
// The shelf's colours are the publications' background colours: boot.ts picks seven
// different ones at random on every page view (the Figma colours below show without
// JS or before it runs).
import Icon from './Icon.astro';
import { getPublished } from '../lib/publications';

const colors = [
  ...new Set(
    (await getPublished()).map((p) => p.data.color?.toLowerCase()).filter(Boolean) as string[],
  ),
];
---

<footer class="site-footer">
  <div class="wrap bar">
    <svg
      class="shelf"
      viewBox="0 0 154 75"
      width="154"
      height="75"
      aria-hidden="true"
      data-shelf={colors.join(' ')}
    >
      <rect y="27" width="12" height="48" fill="#1b3247"></rect>
      <rect x="16" width="12" height="75" fill="#6c0159"></rect>
      <rect x="32" y="17" width="12" height="58" fill="#baa100"></rect>
      <rect x="48" y="9" width="12" height="66" fill="#5f5800"></rect>
      <rect x="64" y="22" width="12" height="53" fill="#0c6567"></rect>
      <rect x="80" y="27" width="12" height="48" fill="#007c26"></rect>
      <rect x="96" y="63" width="58" height="12" fill="#e85341"></rect>
    </svg>
    <div class="about">
      <p class="t-paragraph">
        A collection of books, essays, magazines and so on. All about type design across cultures,
        scripts and languages.
      </p>
      <p class="t-paragraph">
        <a class="u-link" href="/about">
          About the project
        </a>
      </p>
    </div>
    <div class="end">
      <a class="trigger t-caption" href="#top" data-back-to-top>
        Back to top
        <Icon name="up" />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--x3l);
  }
  /* Desktop: shelf | text | back to top, aligned on their bottom edge. */
  .bar {
    display: grid;
    grid-template-columns: minmax(154px, 372px) minmax(0, 1fr) minmax(max-content, 372px);
    align-items: end;
    gap: var(--m);
    padding-top: var(--xl);
    padding-bottom: var(--x3l);
  }
  .shelf {
    width: 154px;
    height: 75px;
  }
  .about {
    display: grid;
    gap: var(--l);
  }
  .end {
    justify-self: end;
  }

  /* Phones: shelf and "Back to top" on one row, the text below. */
  @media (max-width: 720px) {
    .site-footer {
      margin-top: var(--m);
    }
    .bar {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'shelf end' 'about about';
      row-gap: var(--xxl);
      padding-top: var(--m);
      padding-bottom: var(--xxl);
    }
    .shelf {
      grid-area: shelf;
    }
    .end {
      grid-area: end;
    }
    .about {
      grid-area: about;
    }
  }
</style>
