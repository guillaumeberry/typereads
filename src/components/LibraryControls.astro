---
// Search, filters, sort and view toggle. Server-rendered but hidden until the
// library script runs (progressive enhancement: without JS, the full grid shows).
import { AVAILABILITY, DATE_BUCKETS, FORMATS, SCRIPTS, TYPES } from '../data/taxonomies';
import { languageName } from '../lib/format';
import type { Publication } from '../lib/publications';
import { bucketOf } from '../scripts/library-core';

interface Props {
  pubs: Publication[];
}
const { pubs } = Astro.props;

// Only offer values that exist in the data.
const present = <T extends string>(values: T[]) => new Set(values);
const types = present(pubs.map((p) => p.data.type));
const formats = present(pubs.flatMap((p) => p.data.formats));
const scripts = present(pubs.flatMap((p) => p.data.scripts));
const avail = present(pubs.map((p) => p.data.availability).filter((a) => a !== 'unknown'));
const buckets = present(pubs.map((p) => bucketOf(p.data.year)));
const langs = [
  ...present(
    pubs.flatMap((p) => [...p.data.languages, ...p.data.translations.map((t) => t.language)]),
  ),
]
  .map((code) => ({ code, name: languageName(code) }))
  .sort((a, b) => a.name.localeCompare(b.name));

type Option = { value: string; label: string; glyph?: string };
type GroupDef = { id: string; legend: string; options: Option[]; kind: 'checkbox' | 'radio' };
const groups: GroupDef[] = [
  {
    id: 'type',
    legend: 'Type',
    kind: 'checkbox',
    options: Object.entries(TYPES)
      .filter(([v]) => types.has(v as never))
      .map(([value, label]) => ({ value, label })),
  },
  {
    id: 'format',
    legend: 'Format',
    kind: 'checkbox',
    options: Object.entries(FORMATS)
      .filter(([v]) => formats.has(v as never))
      .map(([value, label]) => ({ value, label })),
  },
  {
    id: 'lang',
    legend: 'Language',
    kind: 'checkbox',
    options: langs.map((l) => ({ value: l.code, label: l.name })),
  },
  {
    id: 'script',
    legend: 'Script covered',
    kind: 'checkbox',
    options: Object.entries(SCRIPTS)
      .filter(([v]) => scripts.has(v as never))
      .map(([value, s]) => ({ value, label: s.label, glyph: s.glyph })),
  },
  {
    id: 'date',
    legend: 'Published',
    kind: 'radio',
    options: [
      { value: '', label: 'Any time' },
      ...DATE_BUCKETS.filter((b) => buckets.has(b.id)).map((b) => ({
        value: b.id,
        label: b.label,
      })),
    ],
  },
  {
    id: 'avail',
    legend: 'Availability',
    kind: 'checkbox',
    options: Object.entries(AVAILABILITY)
      .filter(([v]) => avail.has(v as never))
      .map(([value, label]) => ({ value, label })),
  },
].filter((g) => g.options.length > (g.kind === 'radio' ? 1 : 0)) as GroupDef[];
---

<div class="controls" data-controls hidden>
  <div class="toolbar">
    <label class="search">
      <span class="visually-hidden">Search publications</span>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
        <path d="m11 11 3.5 3.5" stroke="currentColor" stroke-width="1.6"></path>
      </svg>
      <input
        type="search"
        name="q"
        data-q
        placeholder={`Search ${pubs.length} publications`}
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        aria-keyshortcuts="/"
      />
      <kbd aria-hidden="true">/</kbd>
    </label>
    <button
      type="button"
      class="btn"
      data-filters-toggle
      aria-expanded="false"
      aria-controls="filters"
    >
      Filters <span class="badge" data-badge hidden></span>
    </button>
    <label class="sort">
      <span class="visually-hidden">Sort by</span>
      <select data-sort>
        <option value="added">Recently added</option>
        <option value="year-desc">Newest first</option>
        <option value="year-asc">Oldest first</option>
        <option value="title">Title A→Z</option>
      </select>
    </label>
    <div class="view" role="group" aria-label="View">
      <button type="button" class="btn" data-view="grid" aria-pressed="true">
        Grid
      </button>
      <button type="button" class="btn" data-view="list" aria-pressed="false">
        List
      </button>
    </div>
  </div>

  <dialog id="filters" class="panel" data-panel aria-labelledby="filters-title">
    <form method="dialog" data-filter-form>
      <div class="panel-head">
        <h2 id="filters-title" class="display">
          Filters
        </h2>
        <button type="submit" class="close" aria-label="Close filters">
          ×
        </button>
      </div>
      <div class="groups">
        {groups.map((g) => (
          <fieldset data-group={g.id}>
            <legend class="label">{g.legend}</legend>
            <div class="options">
              {g.options.map((o) => (
                <label class="opt">
                  <input
                    type={g.kind}
                    name={g.id}
                    value={o.value}
                    checked={g.kind === 'radio' && !o.value}
                  />
                  <span class="chip">
                    {o.glyph && (
                      <span class="glyph" aria-hidden="true">
                        {o.glyph}
                      </span>
                    )}
                    {o.label}
                    {o.value && <span class="n" data-count />}
                  </span>
                </label>
              ))}
            </div>
            {g.id === 'lang' && (
              <label class="switch">
                <input type="checkbox" name="tr" checked />
                <span>Include translations</span>
              </label>
            )}
          </fieldset>
        ))}
      </div>
      <div class="panel-foot">
        <button type="button" class="btn link" data-reset>
          Reset all
        </button>
        <button type="submit" class="btn primary" data-show>
          Show results
        </button>
      </div>
    </form>
  </dialog>

  <div class="status">
    <ul class="active" data-active role="list" aria-label="Active filters"></ul>
  </div>
</div>

<style>
  .controls {
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }
  .controls[hidden] {
    display: none;
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .search {
    position: relative;
    flex: 1 1 260px;
    display: flex;
    align-items: center;
  }
  .search svg {
    position: absolute;
    left: 12px;
    color: var(--muted);
    pointer-events: none;
  }
  .search input {
    width: 100%;
    height: 40px;
    padding: 0 40px 0 36px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .search input:focus-visible {
    outline-offset: 0;
    border-color: var(--fg);
  }
  .search kbd {
    position: absolute;
    right: 10px;
    padding: 0 6px;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--muted);
    font: inherit;
    font-size: var(--step--1);
  }
  .search input:focus ~ kbd,
  .search input:not(:placeholder-shown) ~ kbd {
    display: none;
  }
  /* No keyboard shortcut hint on touch screens. */
  @media (hover: none) {
    .search kbd {
      display: none;
    }
  }
  .btn,
  .sort select {
    height: 40px;
    padding: 0 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
    white-space: nowrap;
  }
  .btn:hover,
  .sort select:hover {
    border-color: var(--muted);
  }
  .btn[aria-expanded='true'],
  .btn[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .badge[hidden] {
    display: none;
  }
  .badge {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    margin-left: 4px;
    padding: 0 5px;
    border-radius: 10px;
    background: var(--focus);
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .view {
    display: flex;
  }
  .view .btn + .btn {
    margin-left: -1px;
  }

  /* Filter panel: inline under the toolbar on desktop (non-modal dialog). */
  .panel {
    position: static;
    width: auto;
    max-width: none;
    margin: 12px 0 0;
    padding: 0;
    background: var(--surface);
    color: var(--fg);
    border: 1px solid var(--line);
  }
  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px 0;
  }
  .panel-head h2 {
    font-size: var(--step-1);
  }
  .close {
    width: 40px;
    height: 40px;
    background: none;
    border: 0;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px 32px;
    padding: 12px 20px 20px;
  }
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  legend {
    margin-bottom: 8px;
    color: var(--muted);
  }
  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 18px;
    cursor: pointer;
    transition:
      background var(--dur-fast),
      color var(--dur-fast),
      transform var(--dur-fast) var(--spring);
  }
  .chip:active {
    transform: scale(0.95);
  }
  .opt input:checked + .chip {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .opt input:focus-visible + .chip {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .opt input:disabled + .chip {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .glyph {
    font-size: 1.1em;
    font-weight: 700;
  }
  .n {
    font-size: var(--step--1);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .opt input:checked + .chip .n {
    color: inherit;
    opacity: 0.7;
  }
  .switch {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .switch input {
    accent-color: var(--fg);
  }
  .panel-foot {
    display: none;
  }
  .status {
    margin-top: 12px;
  }
  .active {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .active:empty {
    display: none;
  }
  .active :global(button) {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    background: var(--fg);
    color: var(--bg);
    border: 0;
    border-radius: 16px;
    cursor: pointer;
    font-size: var(--step--1);
  }
  .active :global(.reset) {
    background: none;
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Mobile: the panel becomes a modal bottom sheet. */
  @media (max-width: 720px) {
    .sort,
    .view {
      flex: 1;
    }
    .sort select {
      width: 100%;
    }
    .view .btn {
      flex: 1;
    }
    .panel:modal {
      position: fixed;
      inset: auto 0 0 0;
      width: 100%;
      max-height: 85vh;
      margin: 0;
      border-radius: 12px 12px 0 0;
      overflow: auto;
      overscroll-behavior: contain;
    }
    .panel::backdrop {
      background: rgb(0 0 0 / 0.6);
    }
    .groups {
      grid-template-columns: 1fr;
    }
    .chip {
      min-height: 44px;
    }
    .panel-foot {
      position: sticky;
      bottom: 0;
      display: flex;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 20px calc(12px + env(safe-area-inset-bottom));
      background: var(--surface);
      border-top: 1px solid var(--line);
    }
    .primary {
      flex: 1;
      background: var(--fg);
      color: var(--bg);
      border-color: var(--fg);
      font-weight: 700;
    }
    .link {
      background: none;
      border: 0;
      text-decoration: underline;
    }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 720px) {
    .panel:modal {
      animation: sheet-in var(--dur-slow) var(--ease-out);
    }
  }
  @keyframes sheet-in {
    from {
      transform: translateY(100%);
    }
  }
</style>
