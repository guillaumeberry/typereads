---
// The filter panel and the search row, opened from the header buttons (LibraryTools.astro). Server-rendered but hidden
// until the library script runs (without JS, the full grid shows).
//
// Filter panel (Figma "Filters", ADR-013): one choice per group (Type, Format,
// Publication, Sorting), applied as soon as it's picked. It opens under the header,
// attached to the Filter button, and pushes the publications down; full width, four
// columns on desktop, one on phones. Language, script and availability filters aren't
// in the design: they still work from a URL and are cleared by Reset.
import Icon from './Icon.astro';
import { DATE_BUCKETS, FORMATS, TYPES } from '../data/taxonomies';
import type { Publication } from '../lib/publications';
import { bucketOf } from '../scripts/library-core';
import { allYears } from '../lib/editions';

interface Props {
  pubs: Publication[];
}
const { pubs } = Astro.props;

// Only offer values that exist in the data.
const types = new Set(pubs.map((p) => p.data.type));
const formats = new Set(pubs.flatMap((p) => p.data.formats));
// Every edition and issue year counts (ADR-014).
const buckets = new Set(pubs.flatMap((p) => allYears(p.data).map(bucketOf)));
const PLURAL: Record<string, string> = { book: 'Books', magazine: 'Magazines', web: 'Websites' };

type Option = { value: string; label: string };
type Group = { id: string; legend: string; hideLegend?: boolean; options: Option[] };
const groups: Group[] = [
  {
    id: 'type',
    legend: 'Type',
    options: [
      { value: '', label: 'All' },
      ...Object.entries(TYPES)
        .filter(([v]) => types.has(v as never))
        .map(([value, label]) => ({ value, label: PLURAL[value] ?? label })),
    ],
  },
  {
    id: 'format',
    legend: 'Format',
    options: [
      { value: '', label: 'Physical + Digital' },
      ...Object.entries(FORMATS)
        .filter(([v]) => formats.has(v as never))
        .map(([value, label]) => ({ value, label })),
    ],
  },
  {
    id: 'date',
    legend: 'Publication',
    options: [
      { value: '', label: 'Anytime' },
      ...DATE_BUCKETS.filter((b) => buckets.has(b.id)).map((b) => ({
        value: b.id,
        label: b.label,
      })),
    ],
  },
  {
    id: 'sort',
    legend: 'Sorting',
    hideLegend: true, // on phones; the column heading shows on desktop
    options: [
      { value: 'year-desc', label: 'Recent first' },
      { value: 'year-asc', label: 'Oldest first' },
      { value: 'added', label: 'Recently added' },
      { value: 'title', label: 'A › Z' },
      { value: 'title-desc', label: 'Z › A' },
    ],
  },
];
---

<div class="controls" data-controls hidden>
  <div
    class="panel"
    id="filters"
    data-panel
    role="region"
    aria-label="Filter and sort"
    tabindex="-1"
    hidden
  >
    <form data-filter-form>
      <div class="groups">
        <span class="rule rule-1" aria-hidden="true"></span>
        <span class="rule rule-2" aria-hidden="true"></span>
        {groups.map((g) => (
          <div class="group" data-group={g.id} role="radiogroup" aria-labelledby={`legend-${g.id}`}>
            <p
              class:list={['legend', 't-caption', { 'phone-hidden': g.hideLegend }]}
              id={`legend-${g.id}`}
            >
              {g.legend}
            </p>
            <div class="options">
              {g.options.map((o, i) => (
                <label class="opt">
                  <input type="radio" name={g.id} value={o.value} checked={i === 0} />
                  <span class="t-caption">{o.label}</span>
                  <Icon name="radio" />
                </label>
              ))}
            </div>
          </div>
        ))}
      </div>
      <button type="button" class="reset t-caption" data-reset>
        <Icon name="close" />
        <span>Reset</span>
      </button>
    </form>
  </div>

  <!-- Search (Figma "Search field"): a white bar laid over the header, a bordered field
       with the shortcut tag, and × to clear and close. -->
  <div class="search-row" id="search-row" data-search-row role="search" hidden>
    <label class="field">
      <span class="visually-hidden">Search {pubs.length} publications</span>
      <input
        type="search"
        name="q"
        data-q
        placeholder="Search"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
      />
      <kbd class="t-caption shortcut" aria-hidden="true" data-shortcut>
        ⌘ K
      </kbd>
    </label>
    <button type="button" class="close" data-search-close aria-label="Close search">
      <Icon name="close" />
    </button>
  </div>

  <!-- Not shown (the Filter button carries the number of filters): screen readers
       still hear the result count after each change. -->
  <div class="visually-hidden" data-status>
    <p data-count-total aria-live="polite">
      {pubs.length} publications
    </p>
    <ul data-active hidden></ul>
  </div>
</div>

<style>
  .controls {
    display: grid;
    gap: var(--s);
  }
  .controls[hidden],
  .search-row[hidden],
  .panel[hidden] {
    display: none;
  }

  /* --- Search bar (Figma "Search field") ------------------------------------ */
  /* Laid over the header: from the header's top padding (32px; 16px on phones) to
     its bottom edge, the full content width. .lib starts at the header's bottom
     (140px; 104px on phones), so the bar sits 108px (88px) above it. */
  .search-row {
    position: absolute;
    top: -108px;
    left: var(--gutter);
    right: var(--gutter);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--l);
    height: 108px;
    padding: var(--l);
    background: var(--surface);
  }
  .field {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--m);
    height: 100%;
    padding: 0 var(--m);
    border: 1px solid var(--fg);
  }
  .field input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0;
    background: none;
    border: 0;
    font-size: var(--paragraph);
    -webkit-appearance: none;
    appearance: none;
  }
  .field input:focus {
    outline: none;
  }
  /* Focus: the border thickens (black, on-brand) instead of the blue ring, which would
     show every time the bar opens since the field takes focus. */
  .field:has(input:focus) {
    box-shadow: inset 0 0 0 1px var(--fg);
  }
  /* The placeholder in the Caption style: "SEARCH". */
  .field input::placeholder {
    color: var(--fg);
    opacity: 1;
    font-size: var(--caption);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .field input::-webkit-search-cancel-button {
    display: none;
  }
  .shortcut {
    flex: none;
    display: flex;
    align-items: center;
    height: 21px;
    padding: 0 var(--xxs);
    border: 1px solid var(--fg);
    border-radius: 2px;
    font-family: inherit;
  }
  .field input:not(:placeholder-shown) ~ .shortcut {
    display: none;
  }
  @media (hover: none) {
    .shortcut {
      display: none;
    }
  }
  .close {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin: -6px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--fg);
    cursor: pointer;
  }
  .close :global(svg) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) {
    .close:hover :global(svg) {
      transform: rotate(90deg);
    }
  }
  @media (max-width: 720px) {
    .search-row {
      top: -88px;
      height: 72px;
      gap: var(--s);
      padding: var(--s);
    }
    .field input::placeholder {
      font-size: var(--caption);
    }
  }
  /* It drops in from the top and lifts away when closed. */
  @media (prefers-reduced-motion: no-preference) {
    .search-row:not([hidden]) {
      animation: bar-in var(--dur-slow) var(--ease-out) both;
    }
    .search-row.is-leaving {
      animation: bar-out var(--dur-base) var(--ease-in-out) both;
    }
  }
  @keyframes bar-in {
    from {
      opacity: 0;
      transform: translateY(-16px);
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes bar-out {
    to {
      opacity: 0;
      transform: translateY(-16px);
      clip-path: inset(0 0 100% 0);
    }
  }

  /* --- Filter panel ------------------------------------------------------- */
  /* In the page flow, so it pushes the publications down. It starts 16px under the
     header, where the Filter button (dropped 16px, LibraryTools.astro) meets it, and
     the grid follows 64px below (16px on phones), as in Figma. */
  .panel {
    margin-top: calc(var(--m) - var(--x3l));
    padding: var(--l);
    background: var(--surface);
    color: var(--fg);
  }
  .controls:has(.panel:not([hidden])) {
    margin-bottom: var(--x3l);
  }
  .panel:focus {
    outline: none;
  }

  /* Desktop: four columns; a rule under the headings and under the options. */
  .groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: auto auto;
    column-gap: var(--x3l);
  }
  /* Each group is placed explicitly (column n, rows 1–2), so it shares those rows with
     the full-width rules instead of being pushed below them by auto-placement. */
  .group {
    display: grid;
    grid-row: 1 / span 2;
    grid-template-rows: subgrid;
  }
  .group:nth-of-type(1) {
    grid-column: 1;
  }
  .group:nth-of-type(2) {
    grid-column: 2;
  }
  .group:nth-of-type(3) {
    grid-column: 3;
  }
  .group:nth-of-type(4) {
    grid-column: 4;
  }
  .legend {
    padding-bottom: var(--l);
  }
  .options {
    display: grid;
    align-content: start;
    gap: var(--m);
    padding: var(--xl) 0 var(--l);
  }
  .rule {
    grid-column: 1 / -1;
    align-self: end;
    border-bottom: 1px solid var(--fg);
  }
  .rule-1 {
    grid-row: 1;
  }
  .rule-2 {
    grid-row: 2;
  }

  /* An option: its name, then a radio dot (filled when chosen). */
  .opt {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--m);
    cursor: pointer;
  }
  .opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  /* Figma: 19px radio icons; the sort options are 20px apart (the others 16px). */
  .opt :global(svg) {
    width: 19px;
    height: 19px;
  }
  [data-group='sort'] .options {
    gap: 20px;
  }
  .opt :global(.dot) {
    transform: scale(0);
    transform-origin: center;
    transform-box: fill-box;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .opt input:checked ~ :global(svg .dot) {
    transform: scale(1);
  }
  .opt input:checked ~ :global(svg .ring) {
    opacity: 0;
  }
  /* Hover: the site's link underline (Figma "Link") draws in under the option's name
     and Reset, and slides away when the pointer leaves. */
  .opt span,
  .reset span {
    padding-bottom: 3px;
    background: linear-gradient(currentColor, currentColor) 100% 100% / 0 1px no-repeat;
    transition: background-size var(--dur-slow) var(--ease-out);
  }
  @media (hover: hover) {
    .opt:hover span,
    .reset:hover span {
      background-position: 0 100%;
      background-size: 100% 1px;
    }
  }
  .opt:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
  /* Choices with no results under the other filters are dimmed, never hidden. */
  .opt:has(input:disabled) {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* A block-level row (no line box under it), so the panel's height matches Figma. */
  .reset {
    display: flex;
    align-items: center;
    gap: var(--xs);
    margin-top: var(--xl);
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* --- Phones: one column, each group closed by a rule -------------------- */
  @media (max-width: 720px) {
    /* Phones: the panel starts right under the header (the 16px page padding is
       taken back) and the grid follows 16px below. */
    .panel {
      margin-top: calc(-1 * var(--m));
      padding: var(--m);
    }
    .controls:has(.panel:not([hidden])) {
      margin-bottom: var(--m);
    }
    [data-group='sort'] .options {
      gap: var(--xs);
    }
    .groups {
      display: flex;
      flex-direction: column;
      gap: var(--m);
    }
    .group {
      display: flex;
      flex-direction: column;
      gap: var(--xs);
      padding-bottom: var(--m);
      border-bottom: 1px solid var(--fg);
    }
    .legend {
      padding: 0;
    }
    .legend.phone-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .options {
      gap: var(--xs);
      padding: 0;
    }
    .rule {
      display: none;
    }
    .reset {
      margin-top: var(--m);
    }
  }

  /* The panel unrolls from the Filter button down as it opens (the publications glide
     down with it, library.ts) and rolls back up as it closes. */
  @media (prefers-reduced-motion: no-preference) {
    .panel:not([hidden]) {
      animation: panel-in var(--dur-slow) var(--ease-out) both;
    }
    .panel.is-leaving {
      animation: panel-out var(--dur-base) var(--ease-in-out) both;
    }
    .panel:not([hidden]) .groups,
    .panel:not([hidden]) .reset {
      animation: panel-content-in var(--dur-slow) var(--ease-out) 120ms both;
    }
  }
  @keyframes panel-in {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes panel-out {
    from {
      clip-path: inset(0);
    }
    to {
      clip-path: inset(0 0 100% 0);
      opacity: 0.6;
    }
  }
  @keyframes panel-content-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>
