---
// UI icons from the Figma file ("Icons L" 48px, "Icons S" 19px), drawn in
// currentColor. Decorative: the button or link around them carries the name.
interface Props {
  name:
    | 'plus'
    | 'plus-small'
    | 'arrow'
    | 'switch'
    | 'search'
    | 'filter'
    | 'up'
    | 'close'
    | 'back'
    | 'external'
    | 'radio'
    | 'dropdown'
    | 'next'
    | 'down';
  class?: string;
}
const { name, class: cls } = Astro.props;
const box = { plus: 48, arrow: 48, 'plus-small': 20, radio: 20 }[name as string] ?? 19;
---

<svg
  class:list={['icon', `icon-${name}`, cls]}
  viewBox={`0 0 ${box} ${box}`}
  width={box}
  height={box}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {name === 'plus' && (
    <path d="M25 15c0 4.42 3.58 8 8 8h12v2H33c-4.42 0-8 3.58-8 8v12h-2V33c0-4.42-3.58-8-8-8H3v-2h12c4.42 0 8-3.58 8-8V3h2z" />
  )}
  {name === 'plus-small' && (
    <path d="M11 6c0 1.66 1.34 3 3 3h6v2h-6c-1.66 0-3 1.34-3 3v6H9v-6c0-1.66-1.34-3-3-3H0V9h6c1.66 0 3-1.34 3-3V0h2z" />
  )}
  {name === 'arrow' && <path d="M26 35v-6a4 4 0 0 0-4-4H8v-2h14a4 4 0 0 0 4-4v-6l14 11z" />}
  {name === 'switch' && (
    <>
      <rect x="3" y="9" width="13" height="1" />
      <circle class="knob" cx="6.5" cy="9.5" r="4.5" />
    </>
  )}
  {name === 'search' && (
    <path d="M8 3a5 5 0 0 1 3.87 8.16L16 15.3l-.7.7-4.14-4.13A5 5 0 1 1 8 3z" />
  )}
  {name === 'filter' && <path d="M4 16H3V3h1zm6 0H9V3h1zm6 0h-1V3h1z" />}
  {name === 'up' && <path d="M10 2l5 6h-3a2 2 0 0 0-2 2v7H9v-7a2 2 0 0 0-2-2H4l5-6z" />}
  {name === 'dropdown' && <path d="M10 6a2 2 0 0 0 2 2h3l-5 6H9L4 8h3a2 2 0 0 0 2-2V5h1z" />}
  {name === 'next' && <path d="M6 9a2 2 0 0 0 2-2V4l6 5v1l-6 5v-3a2 2 0 0 0-2-2H5V9z" />}
  {name === 'down' && <path d="M10 9a2 2 0 0 0 2 2h3l-5 6H9l-5-6h3a2 2 0 0 0 2-2V2h1z" />}
  {name === 'radio' && (
    <>
      <circle class="ring" cx="10" cy="10" r="4.5" fill="none" stroke="currentColor" />
      <circle class="dot" cx="10" cy="10" r="5" />
    </>
  )}
  {name === 'back' && <path d="M2 10l6 5v-3a2 2 0 0 1 2-2h7V9h-7a2 2 0 0 1-2-2V4L2 9z" />}
  {name === 'external' && (
    <path d="M15 13l-2.73-2.73a2 2 0 0 0-2.83 0l-4.59 4.58-.7-.7 4.58-4.59a2 2 0 0 0 0-2.83L6 4h9z" />
  )}
  {name === 'close' && (
    <path d="M17.16 2.55l-4.12 4.12a4 4 0 0 0 0 5.66l4.12 4.12-.71.71-4.12-4.12a4 4 0 0 0-5.66 0L2.55 17.16l-.71-.71 4.12-4.12a4 4 0 0 0 0-5.66L1.84 2.55l.71-.71 4.12 4.12a4 4 0 0 0 5.66 0l4.12-4.12z" />
  )}
</svg>

<style>
  .icon {
    flex: none;
    display: block;
  }
  /* The view switch: the knob slides right while the list view is shown. */
  .knob {
    transition: transform var(--dur-base) var(--ease-out);
  }
  :global([data-current='list']) > .icon-switch .knob {
    transform: translateX(6px);
  }
</style>
