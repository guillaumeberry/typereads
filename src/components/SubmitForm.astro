---
// The public form (Figma "Submission Form", ADR-013): a new publication, or a correction
// when `fix` is given. A native form posting to /api/submit (worker/index.ts);
// src/scripts/submit.ts adds Turnstile, in-place sending and inline errors. Field
// limits mirror src/lib/submission.ts. Used in the submission panel (SubmitPanel.astro)
// and on the /submit and /submit/fix/… pages; `id` keeps element ids unique when both
// are on a page.
import Icon from './Icon.astro';
import { TYPES } from '../data/taxonomies';

interface Props {
  fix?: { slug: string; title: string };
  id?: string;
}
const { fix, id = 'form' } = Astro.props;
// Turnstile site key (public, not a secret). A local build can override it with
// PUBLIC_TURNSTILE_SITEKEY, e.g. Cloudflare's test key 1x00000000000000000000AA.
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '0x4AAAAAAGHY62wOEXbS2aZj';
const err = (name: string) => `${id}-err-${name}`;
const fid = (name: string) => `${id}-${name}`;
const label = fix ? 'Send the correction' : 'Submit publication';
---

<form method="post" action="/api/submit" class="form" data-submit novalidate>
  <noscript>
    <p class="notice t-paragraph">
      The spam check needs JavaScript. Without it, please email
      <a href="mailto:hello@typereads.xyz">hello@typereads.xyz</a>.
    </p>
  </noscript>
  <p class="notice t-paragraph" data-error-for="form" id={err('form')} role="alert" hidden></p>

  {fix && (
    <>
      <input type="hidden" name="mode" value="fix" />
      <input type="hidden" name="fix" value={fix.slug} />
      <input type="hidden" name="pubtitle" value={fix.title} />
    </>
  )}

  {fix ? (
    <fieldset class="section">
      <legend class="heading t-caption">The correction (mandatory)</legend>
      <div class="field">
        <label class="t-caption" for={fid('change')}>
          What should change? *
        </label>
        <textarea
          id={fid('change')}
          name="change"
          rows="6"
          required
          maxlength="2000"
          placeholder="A wrong year, a missing author, a broken link…"
          aria-describedby={err('change')}
        />
        <span class="err t-caption" id={err('change')} data-error-for="change" />
      </div>
    </fieldset>
  ) : (
    <fieldset class="section">
      <legend class="heading t-caption">Publication (mandatory)</legend>
      <div class="field">
        <label class="t-caption" for={fid('title')}>
          Title *
        </label>
        <input
          id={fid('title')}
          name="title"
          required
          maxlength="300"
          autocomplete="off"
          placeholder="Name of the publication"
          aria-describedby={err('title')}
        />
        <span class="err t-caption" id={err('title')} data-error-for="title" />
      </div>
      <div class="field">
        <label class="t-caption" for={fid('authors')}>
          Author(s) *
        </label>
        <input
          id={fid('authors')}
          name="authors"
          required
          maxlength="300"
          placeholder="Comma separated, please"
          aria-describedby={err('authors')}
        />
        <span class="err t-caption" id={err('authors')} data-error-for="authors" />
      </div>
      <div class="field">
        <label class="t-caption" for={fid('type')}>
          Type *
        </label>
        <div class="select">
          <select id={fid('type')} name="type" required aria-describedby={err('type')}>
            <option value="">Choose</option>
            {Object.entries(TYPES).map(([value, name]) => (
              <option value={value}>{name}</option>
            ))}
            <option value="other">Other</option>
          </select>
          <Icon name="dropdown" />
        </div>
        <span class="err t-caption" id={err('type')} data-error-for="type" />
      </div>
    </fieldset>
  )}

  <fieldset class="section">
    <legend class="heading t-caption">
      {fix ? 'You (optional)' : 'Additional information (optional)'}
    </legend>
    {!fix && (
      <div class="field">
        <label class="t-caption" for={fid('publisher')}>
          Publisher
        </label>
        <input
          id={fid('publisher')}
          name="publisher"
          maxlength="200"
          placeholder="Publishing house, individual or organisation"
          aria-describedby={err('publisher')}
        />
        <span class="err t-caption" id={err('publisher')} data-error-for="publisher" />
      </div>
    )}
    <div class="field">
      <label class="t-caption" for={fid('name')}>
        Your name, for public credit in the About page
      </label>
      <input
        id={fid('name')}
        name="name"
        maxlength="100"
        autocomplete="name"
        placeholder="Which name would you like to be displayed?"
        aria-describedby={err('name')}
      />
      <span class="err t-caption" id={err('name')} data-error-for="name" />
    </div>
    <div class="field">
      <label class="t-caption" for={fid('email')}>
        Your email
      </label>
      <input
        id={fid('email')}
        name="email"
        type="email"
        maxlength="200"
        autocomplete="email"
        placeholder="Your valid email address"
        aria-describedby={`${fid('email-help')} ${err('email')}`}
      />
      <span class="help t-caption" id={fid('email-help')}>
        Only so I can reply, never published or stored
      </span>
      <span class="err t-caption" id={err('email')} data-error-for="email" />
    </div>
    <div class="field">
      <label class="check t-paragraph">
        <input type="checkbox" name="consent" value="yes" aria-describedby={err('consent')} />
        <span class="box" aria-hidden="true"></span>I agree my name may be shown as a contributor.
      </label>
      <span class="err t-caption" id={err('consent')} data-error-for="consent" />
    </div>
  </fieldset>

  <div class="hp" aria-hidden="true">
    <label>
      Leave this empty <input name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="turnstile" data-turnstile data-sitekey={sitekey}></div>

  <button type="submit" class="btn-primary t-paragraph" data-label={label}>
    <span data-label-text>{label}</span>
    <span class="btn-icon" aria-hidden="true">
      <Icon name="next" class="out" />
      <Icon name="next" class="in" />
    </span>
  </button>
</form>

<style>
  /* Figma: sections 48px apart (24px on phones); fields 24px apart. */
  .form {
    display: grid;
    gap: var(--xxl);
    color: var(--fg);
  }
  .notice {
    padding: var(--s) var(--m);
    border: 1px solid var(--fg);
  }
  .notice[data-error-for] {
    border-color: var(--danger);
    color: var(--danger);
  }
  .notice[hidden] {
    display: none;
  }
  /* Block layout, not grid: the heading is a floated legend, and only block layout
     clears floats in every browser (in a grid, Safari let the first label ride up
     onto the rule). Fields are 24px apart. */
  .section {
    display: block;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  /* A section heading: a caption above a rule (legends don't take padding well, so the
     rule is drawn under it as a border). Floated, so it is laid out like a normal
     element; its bottom margin is the 24px before the first field (a float's margin
     is kept by the clearance, unlike the next element's margin-top). */
  .heading {
    float: left;
    width: 100%;
    margin: 0 0 var(--l);
    padding: 0 0 var(--l);
    border-bottom: 1px solid var(--fg);
  }
  .heading + * {
    clear: both;
  }
  .section > :not(.heading) + :not(.heading) {
    margin-top: var(--l);
  }
  .field {
    display: grid;
    gap: var(--xs);
    min-width: 0;
  }
  /* "Form/Textfield": 44px, 1px border, 12px padding, Paragraph text. */
  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    height: 44px;
    padding: 0 var(--s);
    background: var(--surface);
    color: var(--fg);
    border: 1px solid var(--fg);
    border-radius: 0;
    font-size: var(--paragraph);
    -webkit-appearance: none;
    appearance: none;
  }
  textarea {
    height: auto;
    min-height: 132px;
    padding: var(--s);
    line-height: 1.6;
    resize: vertical;
  }
  ::placeholder {
    color: var(--fg);
    opacity: 1;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    box-shadow: inset 0 0 0 1px var(--fg);
  }
  [aria-invalid='true'] {
    border-color: var(--danger);
    box-shadow: inset 0 0 0 1px var(--danger);
  }
  .select {
    position: relative;
  }
  .select select {
    padding-right: 40px;
    cursor: pointer;
  }
  .select :global(svg) {
    position: absolute;
    top: 50%;
    right: var(--s);
    margin-top: -9.5px;
    pointer-events: none;
  }
  .help {
    margin-top: var(--xxs);
  }
  .err {
    color: var(--danger);
  }
  .err:empty {
    display: none;
  }

  /* "Checkbox": an 18px box, a 14px black square when ticked. */
  .check {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--xs);
    cursor: pointer;
  }
  .check input {
    position: absolute;
    opacity: 0;
    width: 18px;
    height: 18px;
    margin: 0;
  }
  .box {
    flex: none;
    position: relative;
    width: 18px;
    height: 18px;
    background: var(--surface);
    border: 1px solid var(--fg);
  }
  .box::after {
    content: '';
    position: absolute;
    inset: 1px;
    background: var(--fg);
    transform: scale(0);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .check input:checked + .box::after {
    transform: scale(1);
  }
  .check input:focus-visible + .box {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }
  .turnstile:empty {
    display: none;
  }

  .form > :global(.btn-primary) {
    justify-self: end;
  }

  @media (max-width: 720px) {
    .form {
      gap: var(--l);
    }
  }
</style>
