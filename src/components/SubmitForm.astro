---
// The public form: a new publication, or a correction when `fix` is given. A native
// form posting to /api/submit (worker/index.ts); src/scripts/submit.ts adds Turnstile,
// in-place sending and inline errors. Field limits mirror src/lib/submission.ts.
import { SCRIPTS } from '../data/taxonomies';

interface Props {
  fix?: { slug: string; title: string };
}
const { fix } = Astro.props;
const nextYear = new Date().getFullYear() + 1;
// Turnstile site key (public). Cloudflare's "always passes" test key until the real one
// is set; a local build can override it with PUBLIC_TURNSTILE_SITEKEY.
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '1x00000000000000000000AA';
const err = (name: string) => `err-${name}`;
---

<form method="post" action="/api/submit" class="form" data-submit novalidate>
  <noscript>
    <p class="notice">
      The spam check needs JavaScript. Without it, please email
      <a href="mailto:hello@typereads.xyz">hello@typereads.xyz</a>.
    </p>
  </noscript>
  <p class="notice" data-error-for="form" id={err('form')} role="alert" hidden></p>

  {fix ? (
    <fieldset>
      <legend class="label">The correction</legend>
      <input type="hidden" name="mode" value="fix" />
      <input type="hidden" name="fix" value={fix.slug} />
      <input type="hidden" name="pubtitle" value={fix.title} />
      <label>
        <span>
          What should change? <abbr title="required">*</abbr>
        </span>
        <textarea
          name="change"
          rows="6"
          required
          maxlength="2000"
          aria-describedby={err('change')}
        />
        <small>A wrong year, a missing author, a broken link… Up to 2,000 characters.</small>
        <span class="err" id={err('change')} data-error-for="change" />
      </label>
    </fieldset>
  ) : (
    <fieldset>
      <legend class="label">The publication</legend>
      <label>
        <span>
          Title <abbr title="required">*</abbr>
        </span>
        <input
          name="title"
          required
          maxlength="300"
          autocomplete="off"
          aria-describedby={err('title')}
        />
        <span class="err" id={err('title')} data-error-for="title" />
      </label>
      <label>
        <span>
          Author(s) <abbr title="required">*</abbr>
        </span>
        <input
          name="authors"
          required
          maxlength="300"
          placeholder="Comma-separated"
          aria-describedby={err('authors')}
        />
        <span class="err" id={err('authors')} data-error-for="authors" />
      </label>
      <label>
        <span>
          Type <abbr title="required">*</abbr>
        </span>
        <select name="type" required aria-describedby={err('type')}>
          <option value="">Choose…</option>
          <option value="book">Book</option>
          <option value="magazine">Magazine</option>
          <option value="web">Website &amp; post</option>
          <option value="other">Other</option>
        </select>
        <span class="err" id={err('type')} data-error-for="type" />
      </label>
      <label>
        <span>
          Link <abbr title="required">*</abbr>
        </span>
        <input
          name="link"
          type="url"
          required
          maxlength="500"
          placeholder="https://"
          inputmode="url"
          aria-describedby={`hint-link ${err('link')}`}
        />
        <small id="hint-link">The publisher, shop or web page.</small>
        <span class="err" id={err('link')} data-error-for="link" />
      </label>
      <label>
        <span>Publisher</span>
        <input name="publisher" maxlength="200" aria-describedby={err('publisher')} />
        <span class="err" id={err('publisher')} data-error-for="publisher" />
      </label>
      <label class="short">
        <span>Year</span>
        <input
          name="year"
          type="number"
          min="1450"
          max={nextYear}
          inputmode="numeric"
          aria-describedby={err('year')}
        />
        <span class="err" id={err('year')} data-error-for="year" />
      </label>
      <label>
        <span>Language(s)</span>
        <input
          name="languages"
          maxlength="200"
          placeholder="e.g. English, French"
          aria-describedby={err('languages')}
        />
        <span class="err" id={err('languages')} data-error-for="languages" />
      </label>
      <fieldset class="scripts" aria-describedby={err('scripts')}>
        <legend>Script(s) covered</legend>
        <div class="checks">
          {Object.entries(SCRIPTS).map(([code, s]) => (
            <label class="check">
              <input type="checkbox" name="scripts" value={code} />
              <span>
                {s.label} <span aria-hidden="true">{s.glyph}</span>
              </span>
            </label>
          ))}
        </div>
        <span class="err" id={err('scripts')} data-error-for="scripts" />
      </fieldset>
      <label>
        <span>Why it belongs here</span>
        <textarea name="why" rows="4" maxlength="1000" aria-describedby={err('why')} />
        <small>Up to 1,000 characters.</small>
        <span class="err" id={err('why')} data-error-for="why" />
      </label>
    </fieldset>
  )}

  <fieldset>
    <legend class="label">You (optional)</legend>
    <label>
      <span>Your name, for public credit</span>
      <input name="name" maxlength="100" autocomplete="name" aria-describedby={err('name')} />
      <span class="err" id={err('name')} data-error-for="name" />
    </label>
    <label class="check">
      <input type="checkbox" name="consent" value="yes" aria-describedby={err('consent')} />
      <span>I agree my name may be shown as a contributor.</span>
    </label>
    <span class="err" id={err('consent')} data-error-for="consent"></span>
    <label>
      <span>Your email</span>
      <input
        name="email"
        type="email"
        maxlength="200"
        autocomplete="email"
        aria-describedby={`hint-email ${err('email')}`}
      />
      <small id="hint-email">
        Only so I can reply. It goes to my inbox and is never published or stored with the
        publication.
      </small>
      <span class="err" id={err('email')} data-error-for="email" />
    </label>
  </fieldset>

  <div class="hp" aria-hidden="true">
    <label>
      Leave this empty <input name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="turnstile" data-turnstile data-sitekey={sitekey}></div>

  <p class="public">
    {fix
      ? 'Your message comes to me by email; nothing is published automatically.'
      : 'What you send (except your email) is saved in the site’s public GitHub repository for review, and published only if I accept it.'}
  </p>

  <button type="submit" data-label={fix ? 'Send the correction' : 'Send the suggestion'}>
    {fix ? 'Send the correction' : 'Send the suggestion'}
  </button>
</form>

<style>
  .form {
    display: grid;
    gap: 32px;
    margin-top: 32px;
  }
  .notice {
    padding: 14px 18px;
    border-left: 3px solid var(--accent);
    background: var(--surface);
  }
  .notice[hidden] {
    display: none;
  }
  fieldset {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  legend {
    margin-bottom: 4px;
    padding: 0;
    color: var(--muted);
  }
  label {
    display: grid;
    gap: 6px;
  }
  label > span:first-child {
    font-weight: 600;
  }
  abbr {
    text-decoration: none;
    color: var(--muted);
  }
  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    padding: 11px 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline-offset: 0;
    border-color: var(--fg);
  }
  [aria-invalid='true'] {
    border-color: var(--danger) !important;
  }
  .err {
    color: var(--danger);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .err:empty {
    display: none;
  }
  .short input {
    max-width: 10ch;
  }
  small,
  .public {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .scripts legend {
    font-weight: 600;
    color: var(--fg);
  }
  .checks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 8px 16px;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .check span {
    font-weight: 400;
  }
  .check input {
    width: 18px;
    height: 18px;
    accent-color: var(--fg);
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .turnstile:empty {
    display: none;
  }
  button {
    justify-self: start;
    padding: 12px 22px;
    background: var(--fg);
    color: var(--bg);
    border: 0;
    border-radius: var(--radius);
    font-weight: 700;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.45;
    cursor: progress;
  }
</style>
