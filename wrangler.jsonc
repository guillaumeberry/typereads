// Cloudflare deploy config: a Worker that serves the static build (Workers static
// assets, ADR-003) and runs worker/index.ts for /api/* only (submissions, ADR-005).
// Workers Builds runs `npm run build`, then `npx wrangler deploy` on every push to main.
// Secrets (TURNSTILE_SECRET, GITHUB_TOKEN, RESEND_API_KEY, NOTIFY_TO) live in the
// dashboard, never here.
// The Worker name in the Cloudflare dashboard must match "name" below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typereads",
  "compatibility_date": "2026-11-10",
  "main": "worker/index.ts",
  // No anonymous usage telemetry from wrangler.
  "send_metrics": false,
  // Custom domains: attached on deploy; Cloudflare creates the DNS records and the
  // HTTPS certificate. The domain's DNS is on Cloudflare (registrar: Gandi).
  // Declaring routes turns the workers.dev address off by default; workers_dev keeps
  // it working (its pages point search engines to typereads.xyz via canonical URLs).
  "workers_dev": true,
  "routes": [
    { "pattern": "typereads.xyz", "custom_domain": true },
    { "pattern": "www.typereads.xyz", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html (the ".notdef" page) for unknown URLs.
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Everything else is served without invoking the Worker (free, fastest).
    "run_worker_first": ["/api/*"],
  },
  // 5 submissions per minute per IP and Cloudflare location (on top of Turnstile).
  "ratelimits": [
    { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
  ],
  "observability": { "enabled": true },
}
